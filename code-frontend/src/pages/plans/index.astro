---
// /plans 粮市 —— frontend-spec §4.6
// 分组选择为轻量显隐（原生脚本，见 §7.1 / §10.2），两组均在构建期渲染并排好序。
// 列表卡只展示精简字段（§5.4）；完整信息在 /plans/[id]/，整卡可点、弹框预览（§5.11）。
// 默认东市（国内组）。
// 东西两市（2026-09-20 用户确认）：东市 = 国内组、西市 = 海外组；
// 契约 group 值（domestic / overseas）不变，这里只换界面话术（frontend-spec §4.6）。
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import PlanCard from '../../components/PlanCard.astro';
import Steelyard from '../../components/Steelyard.astro';
import InstrumentSwitch from '../../components/InstrumentSwitch.astro';
import { models } from '../../lib/data.js';
import { planRankValue, startingPriceValue } from '../../lib/format.js';

const file = models();
const DEFAULT = 'domestic';

// 默认排序 = 人工编辑推荐序 rank（契约 §4.3）；缺省排后，兜底按起步价、id。
// sub = 悬签上的小字（东市 = 国内组、西市 = 海外组，见 frontend-spec §1.3 / §4.6）。
const groups = [
  { key: 'domestic', label: '东市', sub: '国内', heading: '东市 · 国内' },
  { key: 'overseas', label: '西市', sub: '海外', heading: '西市 · 海外' },
].map((group) => ({
  ...group,
  items: file.plans
    .filter((p) => p.group === group.key)
    .sort(
      (a, b) =>
        planRankValue(a) - planRankValue(b) ||
        startingPriceValue(a) - startingPriceValue(b) ||
        a.id.localeCompare(b.id)
    ),
}));
---
<Base
  title="粮市"
  description="国内外编程订阅套餐比价，默认按本站编辑推荐序（人工维护）。"
  dataUpdatedAt={file.dataUpdatedAt}
>
  <Steelyard>
    <PageIntro
      eyebrow="GRAIN MARKET"
      name="粮市"
      image="/font-images/sec-shi.png"
      width={157}
      height={80}
      lede="AI 编程订阅套餐榜：粮市分东西两市——东市摆国内套餐，西市摆海外套餐；同市比价、不跨市换算，价目与额度以官方页为准。"
    >
      <p class="page-intro__note">
        共 {file.plans.length} 个套餐，按本站编辑推荐序排开（人工维护，综合模型能力、额度与价格）；未评级排后。
      </p>
    </PageIntro>
  </Steelyard>

  <div data-toggle data-toggle-current={DEFAULT}>
    <InstrumentSwitch
      kind="market"
      label="粮市分组：东市（国内）/ 西市（海外）"
      options={groups}
      current={DEFAULT}
    />

    {
      groups.map((group) => (
        <section data-toggle-panel={group.key} hidden={group.key !== DEFAULT}>
          <h2>{group.heading}</h2>
          <ul class="cards">
            {group.items.map((plan, i) => (
              <li>
                <PlanCard plan={plan} index={i + 1} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
