---
// /plans 粮市 —— frontend-spec §4.6
// 分组选择为轻量显隐（原生脚本，见 §7.1 / §10.2），两组均在构建期渲染并排好序。
// 列表卡只展示精简字段（§5.4）；完整信息在 /plans/[id]/，点标题弹框预览（§5.11）。
// 默认国内组。
import Base from '../../layouts/Base.astro';
import PlanCard from '../../components/PlanCard.astro';
import ToggleBar from '../../components/ToggleBar.astro';
import { models } from '../../lib/data.js';
import { planRankValue, startingPriceValue } from '../../lib/format.js';

const file = models();
const DEFAULT = 'domestic';

// 默认排序 = 人工编辑推荐序 rank（契约 §4.3）；缺省排后，兜底按起步价、id。
const groups = [
  { key: 'domestic', label: '国内' },
  { key: 'overseas', label: '海外' },
].map((group) => ({
  ...group,
  items: file.plans
    .filter((p) => p.group === group.key)
    .sort(
      (a, b) =>
        planRankValue(a) - planRankValue(b) ||
        startingPriceValue(a) - startingPriceValue(b) ||
        a.id.localeCompare(b.id)
    ),
}));
---
<Base
  title="粮市"
  description="国内外编程订阅套餐比价，默认按本站编辑推荐序（人工维护）。"
  dataUpdatedAt={file.dataUpdatedAt}
>
  <h1 class="page-title">
    <img src="/font-images/sec-shi.png" width="157" height="80" alt="粮市" />
  </h1>
  <p>共 {file.plans.length} 个套餐。默认按本站编辑推荐序（人工维护，综合模型能力、额度与价格）；未评级排后。</p>

  <div data-toggle data-toggle-current={DEFAULT}>
    <ToggleBar label="产品分组" options={groups} current={DEFAULT} />

    {
      groups.map((group) => (
        <section data-toggle-panel={group.key} hidden={group.key !== DEFAULT}>
          <h2>{group.label}</h2>
          <ul class="cards">
            {group.items.map((plan, i) => (
              <li>
                <PlanCard plan={plan} index={i + 1} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
