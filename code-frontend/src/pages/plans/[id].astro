---
// /plans/[id] 套餐详情 —— frontend-spec §4.6
// 每个套餐一页 SSG：真 URL、可被 SEO 抓、无 JS 也能看到完整信息；
// 列表页点标题时由弹框 fetch 本页并抽取 <main>（§5.11）。
import Base from '../../layouts/Base.astro';
import { models } from '../../lib/data.js';
import {
  planSourceLabel,
  planStatusLabel,
  startingPriceLabel,
  tierOfferKey,
  tierOfferLabel,
  tierPrice,
} from '../../lib/format.js';
import { planIcon, vendorInitial } from '../../lib/vendors.js';

export function getStaticPaths() {
  return models().plans.map((plan) => ({ params: { id: plan.id }, props: { plan } }));
}

const { plan } = Astro.props;
const file = models();

const icon = planIcon(plan.vendor);
const statusLabel = planStatusLabel(plan.status);
const sourceNote = planSourceLabel(plan.source);

// 价格依据（2026-09-23 UI 审查 01：第三方证据要能直接点开核对）：
// 证据站点只写在契约的 `conditions` 一句话里（契约 §4.3 不新增字段），所以这里在**展示层**
// 把明文域名 / http(s) 链接放行为可点链接——先转义、再用单次 replace 放行，不引入任何注入面。
// 官方页 / 第三方页的区别仍由 source + sourceUrl 表达，抓取日期取 updatedAt。
// 页脚证据行的链接标签按 source 分两种（2026-09-23 用户定）：`sourceUrl` 在数据里始终优先填
// **官方页**（契约 §4.3；它同时是「去订阅」的目标），所以 aggregator 套餐里它**不是**价格出处——
// 真出处（如 codingplan.org）只写在 `conditions` 里、由「档位与额度」区那句承载。
// aggregator 标「官方页」、official 才标「价格依据」，避免把官方入口页说成价格依据。
const escapeHtml = (s) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

const LINKABLE =
  /(https?:\/\/[^\s，。；、）)"'<>]+)|(?<![\w@./-])((?:[a-z0-9-]+\.)+(?:com|cn|org|net|io|ai|dev|top)(?:\/[^\s，。；、）)"'<>]*)?)/gi;

function linkify(text) {
  return escapeHtml(text).replace(LINKABLE, (match, full, bare) =>
    full
      ? `<a href="${full}" target="_blank" rel="noopener noreferrer">${full}</a>`
      : `<a href="https://${bare}" target="_blank" rel="noopener noreferrer">${bare}</a>`
  );
}

const sourceHost = (() => {
  try {
    return new URL(plan.sourceUrl).host;
  } catch {
    return plan.sourceUrl;
  }
})();

// 驿传入口（施工单 §5 第 3 项）：只改指「信息有误？」；from 不做编码；title/url 编码
const tipTitle = encodeURIComponent(`${plan.vendor} ${plan.product}`.slice(0, 120));
const tipUrl = encodeURIComponent(`https://saiboliang.top/plans/${plan.id}/`);
const tipHref = `/tip/?from=/plans/${plan.id}/&type=feedback&title=${tipTitle}&url=${tipUrl}`;

const priced = plan.tiers.filter(
  (t) => t.offerType === 'standard' && typeof t.price === 'number' && t.price > 0
);
const currencies = [...new Set(priced.map((t) => t.currency))];

// 档位条件去重（frontend-spec §4.6）：实测 17/17 套餐的所有档位 conditions 完全相同，
// 逐档重复输出 4662 字符、去重后仅需 1135（省 76%）。全同则提到「档位」区开头显示一次，
// 有差异时才逐档各自显示。
// conditions 可为 null（契约 §4.3：只写一句，没有可写内容就为 null），null 一律不渲染。
const tierConditions = [...new Set(plan.tiers.map((t) => t.conditions).filter(Boolean))];
const sharedConditions = tierConditions.length === 1 ? tierConditions[0] : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: plan.product,
  brand: { '@type': 'Brand', name: plan.vendor },
  url: `https://saiboliang.top/plans/${plan.id}/`,
  ...(plan.tagline ? { description: plan.tagline } : {}),
  ...(priced.length > 0
    ? {
        offers: priced.map((t) => ({
          '@type': 'Offer',
          name: t.name,
          price: t.price,
          priceCurrency: t.currency,
        })),
      }
    : {}),
};
---
<Base
  title={plan.product}
  description={plan.tagline ?? `${plan.vendor} ${plan.product} 套餐档位与价格。`}
  dataUpdatedAt={file.dataUpdatedAt}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <p><a href="/plans/">← 返回套餐榜</a></p>

  <article class="plan-detail" data-group={plan.group}>
    <header class="plan-detail__head">
      <span class="plan-card__status">{statusLabel}</span>

      <h1 class="plan-detail__title">
        {
          icon ? (
            <img
              class={icon.mono ? 'plan-card__icon plan-card__icon--mono' : 'plan-card__icon'}
              src={icon.url}
              alt=""
              width="32"
              height="32"
            />
          ) : (
            <span class="plan-card__icon plan-card__icon--initial" aria-hidden="true">
              {vendorInitial(plan.vendor)}
            </span>
          )
        }
        {plan.product}
      </h1>

      <p class="plan-detail__meta">
        <span>{plan.vendor}</span>
        {plan.quotaBasis && <span>{plan.quotaBasis}</span>}
        <span>更新 {plan.updatedAt}</span>
      </p>

      <p class="plan-detail__price"><span>常规付费起步价</span><strong>{startingPriceLabel(plan)}</strong></p>

      {plan.tagline && <p class="plan-detail__tagline">{plan.tagline}</p>}

      {
        plan.models.length > 0 && (
          <ul class="plan-card__chips">
            {plan.models.map((m) => (
              <li class="badge">{m}</li>
            ))}
          </ul>
        )
      }

      {
        plan.highlights.length > 0 && (
          <ul class="plan-detail__highlights">
            {plan.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        )
      }
    </header>

    <section aria-labelledby="plan-tiers">
      <h2 id="plan-tiers">档位与额度</h2>
      {
        sharedConditions && (
          <p class="plan-tier__conditions">
            <span class="plan-tier__label">价格依据</span>
            <span set:html={linkify(sharedConditions)} />
          </p>
        )
      }
      <div class="plan-tiers-grid">
      {
        plan.tiers.map((tier) => (
          <section class="plan-tier" data-offer={tier.offerType}>
            <header class="plan-tier__head">
              <h3>
                {tier.name}
                {tierOfferKey(tier) !== 'standard' && (
                  <span class="badge" data-offer={tierOfferKey(tier)}>{tierOfferLabel(tier)}</span>
                )}
              </h3>
              <p class="plan-tier__price">
                <strong>{tierPrice(tier)}</strong>
                {tier.note && <span class="plan-tier__note">{tier.note}</span>}
              </p>
            </header>
            {tier.features.length > 0 && (
              <ul class="plan-tier__features">
                {tier.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
            )}
            {!sharedConditions && tier.conditions && (
              <p class="plan-tier__conditions">
                <span class="plan-tier__label">价格依据</span>
                <span set:html={linkify(tier.conditions)} />
              </p>
            )}
          </section>
        ))
      }
      </div>
    </section>

    <section aria-labelledby="plan-tools">
      <h2 id="plan-tools">支持工具</h2>
      <ul class="plan-card__chips">
        {plan.supportedTools.map((t) => <li class="badge">{t}</li>)}
      </ul>
    </section>

    <footer class="plan-detail__foot">
      <a class="plan-detail__cta" href={plan.sourceUrl} target="_blank" rel="noopener noreferrer">
        去订阅
      </a>
      {sourceNote && <span class="badge">{sourceNote}</span>}
      <a href={tipHref}>信息有误？</a>
      <p class="plan-detail__evidence">
        {plan.source === 'aggregator' ? '官方页' : '价格依据'}：<a href={plan.sourceUrl} target="_blank" rel="noopener noreferrer">{sourceHost} ↗</a>
        <span class="plan-detail__evidence-sep">·</span>
        {plan.source === 'aggregator' ? '第三方整理价' : '官方页标价'}
        <span class="plan-detail__evidence-sep">·</span>
        核验于 <time datetime={plan.updatedAt}>{plan.updatedAt}</time>
        <span class="plan-detail__evidence-sep">·</span>
        购买前以<strong>官方结算页</strong>为准
      </p>
    </footer>
  </article>
</Base>
