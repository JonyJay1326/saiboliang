---
import Base from '../../layouts/Base.astro';
import { models } from '../../lib/data.js';
import { renderPlanSheet, marketDomain } from '../../lib/stubs.js';
import { planIcon } from '../../lib/vendors.js';
export function getStaticPaths() {
  return models().plans.map((plan) => ({ params: { id: plan.id }, props: { plan } }));
}
const { plan } = Astro.props;
const file = models();
const view = renderPlanSheet({ ...plan, icon: planIcon(plan.vendor) }, marketDomain(file.plans.filter((p) => p.group === plan.group)));
const priced = plan.tiers.filter((t) => t.offerType === 'standard' && typeof t.price === 'number' && t.price > 0);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: plan.product,
  brand: { '@type': 'Brand', name: plan.vendor },
  url: `https://saiboliang.top/plans/${plan.id}/`,
  ...(plan.tagline ? { description: plan.tagline } : {}),
  ...(priced.length > 0
    ? {
        offers: priced.map((t) => ({
          '@type': 'Offer',
          name: t.name,
          price: t.price,
          priceCurrency: t.currency,
        })),
      }
    : {}),
};
---
<Base title={plan.product} description={plan.tagline ?? `${plan.vendor} ${plan.product} 套餐档位与价格。`} dataUpdatedAt={file.dataUpdatedAt}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="r4-sheet r4-sheet--page" data-sheet data-kind="plan" data-tier={view.tier} set:html={view.html} />
</Base>
