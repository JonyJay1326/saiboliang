---
// /tickets/[id] 票证详情 —— frontend-spec §4.3
// 每票一页 SSG（SEO 主战场）：真实路径 + 完整内容构建期注入。
// 正文用受控 Markdown，仅允许 **粗体** / 列表 / 换行 / [文字](http(s)) 链接（契约 §4.2）。
import Base from '../../layouts/Base.astro';
import { tickets } from '../../lib/data.js';
import { durationLabel, expiredLabel, overdue, serial } from '../../lib/format.js';
import { CATEGORY, REGION } from '../../lib/labels.js';

export function getStaticPaths() {
  return tickets().tickets.map((ticket) => ({ params: { id: ticket.id }, props: { ticket } }));
}

const { ticket } = Astro.props;
const isExpired = ticket.expired === true;
const isOverdue = !isExpired && overdue(ticket);

// 受控 Markdown → HTML：先转义，再只放行白名单语法（契约 §4.2 / §5.1）。
const escapeHtml = (s) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

function renderContent(md) {
  const lines = escapeHtml(md).split('\n');
  const out = [];
  let listOpen = false;

  const inline = (s) =>
    s
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(
        /\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g,
        '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>'
      );

  const closeList = () => {
    if (listOpen) {
      out.push('</ul>');
      listOpen = false;
    }
  };

  for (const raw of lines) {
    const line = raw.trim();
    const bullet = /^[-*]\s+(.*)$/.exec(line);
    if (bullet) {
      if (!listOpen) {
        out.push('<ul>');
        listOpen = true;
      }
      out.push(`<li>${inline(bullet[1])}</li>`);
      continue;
    }
    closeList();
    if (line) out.push(`<p>${inline(line)}</p>`);
  }
  closeList();
  return out.join('\n');
}

const related = tickets()
  .tickets.filter((t) => t.id !== ticket.id && (t.vendor === ticket.vendor || t.category === ticket.category))
  .sort((a, b) => (a.expired === b.expired ? 0 : a.expired ? 1 : -1))
  .slice(0, 4);

const description = ticket.summary ?? `${ticket.title} · ${ticket.vendor}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Offer',
  name: ticket.title,
  description,
  url: `https://saiboliang.top/tickets/${ticket.id}/`,
  seller: { '@type': 'Organization', name: ticket.vendor },
  ...(ticket.expiryDate ? { availabilityEnds: ticket.expiryDate } : {}),
  ...(ticket.expired ? { availability: 'https://schema.org/Discontinued' } : {}),
};
---
<Base title={ticket.title} description={description} dataUpdatedAt={tickets().dataUpdatedAt}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="ticket ticket--detail" data-expired={String(isExpired)}>
    <span class="ticket__serial">{serial(ticket)}</span>

    <header class="ticket__head">
      <h1 class="ticket__title">{ticket.title}</h1>
      <p class="ticket__vendor">{ticket.vendor}</p>
    </header>

    <dl class="ticket__fields">
      <div><dt>分类</dt><dd>{CATEGORY[ticket.category] ?? ticket.category}</dd></div>
      <div><dt>地区</dt><dd>{REGION[ticket.tags.region] ?? ticket.tags.region}</dd></div>
      <div><dt>期限</dt><dd>{durationLabel(ticket)}</dd></div>
    </dl>

    {isOverdue && <p class="ticket__overdue">已逾期 · 待核实</p>}

    <section class="ticket__content" set:html={renderContent(ticket.content)} />

    <p class="ticket__actions">
      <a class="ticket__cta" href={ticket.link} target="_blank" rel="noopener noreferrer">去领取</a>
      <button type="button" data-claim={ticket.id}>我领到了</button>
    </p>

    {isExpired && <div class="ticket__seal">作废</div>}
    {isExpired && <p class="ticket__state">{expiredLabel(ticket)}</p>}

    {ticket.affiliate === true && <span class="ticket__flag">含推广</span>}
  </article>

  <section aria-labelledby="verify">
    <h2 id="verify">核实信息</h2>
    <dl class="ticket__fields">
      <div><dt>首次收录</dt><dd>{ticket.publishedAt}</dd></div>
      <div><dt>最后编辑</dt><dd>{ticket.updatedAt}</dd></div>
      <div><dt>人工推荐分</dt><dd>{ticket.score}</dd></div>
    </dl>
    <p>推荐分为人工判断，不代表客观评测。</p>
  </section>

  {related.length > 0 && (
    <section aria-labelledby="related">
      <h2 id="related">相关票</h2>
      <ul>
        {related.map((t) => (
          <li><a href={`/tickets/${t.id}/`}>{t.title}</a></li>
        ))}
      </ul>
    </section>
  )}
</Base>
