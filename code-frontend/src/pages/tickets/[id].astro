---
import Base from '../../layouts/Base.astro';
import { tickets } from '../../lib/data.js';
import { listedTickets } from '../../lib/format.js';
import { renderTicketSheet } from '../../lib/stubs.js';
export function getStaticPaths() {
  return listedTickets(tickets().tickets).map((ticket) => ({ params: { id: ticket.id }, props: { ticket } }));
}
const { ticket } = Astro.props;
const view = renderTicketSheet(ticket, listedTickets(tickets().tickets));
const description = ticket.summary ?? `${ticket.title} · ${ticket.vendor}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Offer',
  name: ticket.title,
  description,
  url: `https://saiboliang.top/tickets/${ticket.id}/`,
  seller: { '@type': 'Organization', name: ticket.vendor },
  ...(ticket.expiryDate ? { availabilityEnds: ticket.expiryDate } : {}),
  ...(ticket.expired ? { availability: 'https://schema.org/Discontinued' } : {}),
};
---
<Base title={ticket.title} description={description} dataUpdatedAt={tickets().dataUpdatedAt}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="r4-sheet r4-sheet--page" data-sheet data-kind="ticket" data-tier={view.tier} data-urgent={view.urgent || undefined} set:html={view.html} />
</Base>
