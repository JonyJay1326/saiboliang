---
// /tickets 粮票总览 —— frontend-spec §4.2、§5.6
//
// 上架规则（2026-09-18 用户定）：推荐分 <70 与已失效票全站不展示；其余全量渲染（契约 §4.2）。
// 卡片在本页构建期渲染成静态 HTML（无 JS 可读、SEO 可抓）；
// 2026-09-21 用户确认移除筛选区域，按默认顺序直接展示全部上架票。
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import TicketCard from '../../components/TicketCard.vue';
import { tickets } from '../../lib/data.js';
import { listedTickets, ticketDefaultOrder } from '../../lib/format.js';

const file = tickets();
const list = listedTickets([...file.tickets]).sort(ticketDefaultOrder);

---
<Base
  title="粮票"
  description="免费 AI 额度与试用活动列表，按推荐等级与收录时间展示全部上架粮票。"
  dataUpdatedAt={file.dataUpdatedAt}
>
  <PageIntro
    eyebrow="FREE RATIONS"
    name="粮票"
    image="/font-images/sec-liangpiao.png"
    width={153}
    height={80}
    lede="免费 AI 额度与试用：厂商开仓放粮，本站逐张验过才挂——期限、地区如实标注，领取入口直达官方。"
  >
    <p class="page-intro__note">共 {list.length} 张在架票（推荐分 ≥70）。默认排序：推荐分降序 → 收录时间降序。</p>
  </PageIntro>

  {list.length === 0 && <p>暂时空仓，稍后再来看看。</p>}

  <ul class="cards">
    {
      list.map((t) => (
        <li data-ticket-id={t.id}>
          <TicketCard ticket={t} />
        </li>
      ))
    }
  </ul>
</Base>
