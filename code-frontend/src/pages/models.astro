---
// /models 点将台 —— frontend-spec §4.5
// 版式线：拜将台（前三名）+ 点卯簿（第 4 名起，座次 / 入营 / 俸禄 / 战力 / 距榜首）。
// 两榜切换为轻量显隐（原生脚本，见 §7.1 / §10.2），两榜均在构建期渲染。默认综合榜。
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import TigerTally from '../components/TigerTally.astro';
import InstrumentSwitch from '../components/InstrumentSwitch.astro';
import ModelPodium from '../components/ModelPodium.astro';
import ModelRollRow from '../components/ModelRollRow.astro';
import { models } from '../lib/data.js';

const file = models();
const r = file.rankings;
const modelById = new Map(file.models.map((m) => [m.id, m]));
const DEFAULT = 'intelligence';
const boards = [
  { key: 'intelligence', label: '综合榜', rows: r.intelligence },
  { key: 'coding', label: '编程榜', rows: r.coding },
];
const withModel = (row) => ({ ...row, model: modelById.get(row.modelId) ?? null });
---
<Base
  title="点将台"
  description="Artificial Analysis 综合与编程两榜，附公开市场参考价。"
  dataUpdatedAt={file.dataUpdatedAt}
>
  <TigerTally>
    <PageIntro
      eyebrow="MODEL MUSTER"
      name="点将台"
      image="/font-images/sec-jiang.png"
      width={226}
      height={80}
      lede="AI 模型榜：把各家模型拉上点将台，综合与编程两榜依次点卯——战力看指数，俸禄看报价，谁堪大用一榜见分晓。"
    >
      <p class="page-intro__note">
        俸禄单位为 USD / 百万 Token；报价为 Artificial Analysis 公开市场参考价，不代表原厂或全网最低价。
      </p>
    </PageIntro>
  </TigerTally>

  <div data-toggle data-toggle-current={DEFAULT}>
    <InstrumentSwitch kind="army" label="榜单类型" options={boards} current={DEFAULT} />

    {
      boards.map((board) => {
        const rows = board.rows.map(withModel);
        const podium = rows.slice(0, 3);
        const rest = rows.slice(3);
        return (
          <section data-toggle-panel={board.key} hidden={board.key !== DEFAULT}>
            <h2>{board.label}</h2>
            {rows.length === 0 ? (
              <p>本期暂无榜单数据</p>
            ) : (
              <>
                <div class="podium">
                  {podium.map((g) => <ModelPodium row={g} model={g.model} />)}
                </div>
                {rest.length > 0 && (
                  <div class="roll">
                    <h3 class="roll__title">
                      点卯簿
                      <span>第 4 名起 · 共 {rest.length} 将</span>
                    </h3>
                    <div class="roll__head" aria-hidden="true">
                      <span>座次<em>排名</em></span>
                      <span>名将<em>模型</em></span>
                      <span>入营<em>上线</em></span>
                      <span>俸禄<em>输入 / 输出</em></span>
                      <span class="roll__num">战力<em>AA 分</em></span>
                      <span class="roll__num">距榜首<em>分差</em></span>
                    </div>
                    <ol class="roll__rows">
                      {rest.map((g) => <ModelRollRow row={g} model={g.model} topScore={rows[0].score} />)}
                    </ol>
                  </div>
                )}
              </>
            )}
          </section>
        );
      })
    }
  </div>
</Base>
