  /* ── 断点 ─────────────────────────────────────────────── */
  @media (min-width: 40rem) {
    .gates {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 60rem) {
    .gates {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .press {
      grid-template-columns: 1.55fr 1fr;
      /* 不写 align-items:start —— 那样两栏各按内容高度，主条比副条矮一大截、
         底部空出一块（实测 166px vs 246px）。让主条 stretch 撑满，版式才闭合。 */
    }
  }

  /* A 案实测 375px 下五门变两列、邸报独占一行右侧全空。这里改横向滑动，
     一屏一门、scroll-snap 停稳，杜绝孤行。 */
  @media (max-width: 39.99rem) {
    .gates {
      display: flex;
      gap: .7rem;
      margin-inline: -1.25rem;
      padding: 0 1.25rem .3rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-left: 1.25rem;
      -webkit-overflow-scrolling: touch;
      /* 两端渐隐，暗示右边还有内容可滑 */
      mask-image: linear-gradient(90deg, transparent 0, #000 1.25rem, #000 calc(100% - 1.5rem), transparent 100%);
    }

    .gates > li {
      flex: 0 0 78%;
      scroll-snap-align: start;
    }

    /* 五格在窄屏折行时，中缝会多出一道假分隔线，只留首格外侧那一道。 */
    .report {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .report__cell + .report__cell {
      border-left: 0;
    }

    .report__cell:nth-child(even) {
      border-left: 1px solid var(--line-dim);
    }

    .report__cell:nth-child(n + 3) {
      border-top: 1px solid var(--line-dim);
    }

    /* 第五格孤零零占一行，让它横跨两格收尾，版式才闭合。 */
    .report__cell:last-child {
      grid-column: span 2;
      border-left: 0;
    }

    .masthead__stamp {
      display: none;
    }
  }

  /* 钢印在窄屏没地方待，但桌面端也别让它压到标语上。 */
  @media (min-width: 48rem) and (max-width: 64rem) {
    .masthead__stamp {
      right: -.5rem;
      scale: .85;
    }
  }

  /* 悬停位移与边缘光延展是纯装饰，动效偏好者一律直切。 */
  @media (prefers-reduced-motion: reduce) {
    .gate,
    .gate::before,
    .press__lead,
    .gates {
      transition: none;
    }

    .gate:hover,
    .press__lead:hover {
      transform: none;
    }

    .gate:hover::before {
      top: 22%;
      bottom: 22%;
    }
  }
