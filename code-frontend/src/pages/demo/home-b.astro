---
// 【临时 demo，非正式页】首页方案 B：头版式（editorial front page）。
// 与方案 A（跨模块 hub）的取舍：
//   A 把「五门」摆在最前，内容随后；B 把「今日战报」摆在最前，五门随后——
//   先给用户今天值得知道的东西，再给他地图。
// 四条硬纪律（方案 A 评审实测出来的扣分点，逐条对治）：
//   1. h1 必须在（读屏与 SEO 的入口，A 整页 h1Count=0）；
//   2. 同一批数据不许出现两次（A 的「新入库」与「今日份口粮」标题重复计数全为 2）；
//   3. 核验时间只由页脚承担一次，hero 不再复述（A 两处都写「更新于 21:29」）；
//   4. 移动端五门不许孤行（A 的 375px 下邸报独占一行、右侧整块空白）。
// 数据全部来自现有四个契约文件，计数均为前端只读派生（不入库、不改契约）。
// 看完要删：直接删掉 src/pages/demo/ 整个目录即可，不影响任何正式页。
import Base from '../../layouts/Base.astro';
import TicketCard from '../../components/TicketCard.vue';
import { github, models, news, tickets } from '../../lib/data.js';
import {
  addedThisWeek,
  addedWithinDays,
  dibaoDate,
  currencySymbol,
  listedTickets,
  scoreGap,
  startingPrice,
  startingPriceLabel,
  startingPriceValue,
  thous,
  ticketDefaultOrder,
  toBeijing,
} from '../../lib/format.js';

const tk = tickets();
const md = models();
const gh = github();
const nw = news();

const listed = listedTickets([...tk.tickets]).sort(ticketDefaultOrder);
const topTickets = listed.slice(0, 4);
const weekAdd = addedThisWeek(listed).length;

const intel = md.rankings.intelligence ?? [];
const coding = md.rankings.coding ?? [];
const modelById = new Map(md.models.map((m) => [m.id, m]));
const modelName = (row) => modelById.get(row.modelId)?.name ?? row.modelId;

const featured = [...nw.items]
  .filter((item) => item.featured === true)
  .sort((a, b) => (a.publishedAt < b.publishedAt ? 1 : a.publishedAt > b.publishedAt ? -1 : a.id < b.id ? -1 : 1));
const leadNews = featured[0] ?? null;
const sideNews = featured.slice(1, 3);
const news7 = addedWithinDays(nw.items, 7, nw.dataUpdatedAt);

const ghTop = gh.week.items.slice(0, 5);
const modelTop = intel.slice(0, 5);
const topScore = modelTop[0]?.score ?? 0;

// 粮市只比「国产档起步价」：跨币种直接比大小没有意义（¥118 与 $20 谁低取决于汇率口径），
// 站内主受众是中文开发者，单取 domestic 前三档是一把真尺子。
const domestic = md.plans
  .filter((p) => p.group === 'domestic' && startingPriceValue(p) !== Number.POSITIVE_INFINITY)
  .sort((a, b) => startingPriceValue(a) - startingPriceValue(b));
const cheapPlans = domestic.slice(0, 3);
// 榜位用 `startingPriceLabel` 的同一个口径渲染，别在手写一遍取价——
// 上一版用 tiers.find() 取了「第一个 standard 档」，与起步价（最低 standard 档）不是一回事，
// 于是百度千帆显示成 ¥9.9 而起步价标签写 ¥9.9/月起，看着像两套价。
const planLead = (plan) => {
  const start = startingPrice(plan);
  return start ? `${currencySymbol(start.currency)}${start.price}` : '—';
};

const oldest = [tk.dataUpdatedAt, md.dataUpdatedAt, gh.dataUpdatedAt, nw.dataUpdatedAt].filter(Boolean).sort()[0];
const beijing = toBeijing(oldest);
const todayLabel = beijing ? beijing.slice(0, 10) : '';
const dayCn = dibaoDate(oldest) ?? '';

// 战报五数：每个数字后面都跟一个「它凭什么这么说」的分母或增量，不做空头条。
const report = [
  { label: '粮票在架', value: listed.length, unit: '张', note: `本周 +${weekAdd}` },
  { label: '模型入榜', value: md.models.length, unit: '款', note: `综合 ${intel.length} · 编程 ${coding.length}` },
  { label: '套餐比价', value: md.plans.length, unit: '个', note: `国产 ${domestic.length} 档` },
  { label: '开源周榜', value: gh.week.items.length, unit: '项', note: `月榜 ${gh.month.items.length} 项` },
  { label: '近七日要闻', value: news7, unit: '条', note: `本期头条 ${featured.length} 条` },
];

const gates = [
  { href: '/tickets/', name: '粮票', img: '/font-images/sec-liangpiao.png', w: 153, verb: '领', desc: '厂商开仓放粮，逐张验过才挂' },
  { href: '/github/', name: '观星台', img: '/font-images/sec-guanxing.png', w: 228, verb: '望', desc: 'GitHub AI 热门项目周月双榜' },
  { href: '/models/', name: '点将台', img: '/font-images/sec-jiang.png', w: 226, verb: '比', desc: 'Artificial Analysis 能力与报价' },
  { href: '/plans/', name: '粮市', img: '/font-images/sec-shi.png', w: 157, verb: '买', desc: '国内外 AI 编程订阅比价' },
  { href: '/news/', name: '邸报', img: '/font-images/sec-dibao.png', w: 161, verb: '看', desc: 'AI 中文资讯每日精选' },
];
---

<Base title="今日开仓" description="AI 白嫖机会、模型榜单、订阅比价与资讯的每日聚合。" dataUpdatedAt={oldest}>
  {/* ① 头版：标语给气势，五数给实惠。核验时间不在这儿说——页脚说一次就够。 */}
  <section class="masthead">
    {/* 方案 A 整页 h1Count=0，读屏与 SEO 都没有落点。h1 必须是站名本身——
        slogan 图只是它的图形式重复，所以 h1 走 visually-hidden，不与图抢同一句话。 */}
    <h1 class="visually-hidden">赛博粮站 · 今日开仓</h1>
    <div class="masthead__top">
      <img class="masthead__slogan" src="/font-images/slogan.png" width="685" height="80" alt="大厂开仓 · 凭票领饭" />
      {/* 票证钢印：纯装饰，读屏跳过。红边红字 + 旋转，复刻盖章的物理感。 */}
      <span class="masthead__stamp" aria-hidden="true">
        <b>今日开仓</b>
        <i>{todayLabel}</i>
      </span>
    </div>
    <p class="masthead__tagline">AI 白嫖机会 · 模型比价 · 榜单聚合</p>

    <dl class="report" aria-label="今日战报">
      {
        report.map((cell) => (
          <div class="report__cell">
            <dt>{cell.label}</dt>
            <dd>
              <b>{cell.value.toLocaleString('en-US')}</b>
              <span>{cell.unit}</span>
            </dd>
            <p>{cell.note}</p>
          </div>
        ))
      }
    </dl>
  </section>

  {/* ② 五门：只做地图，不做目录——每格只给名字、动词、一句职责，绝不预告下面的条目，
        否则用户滚下去会遇见「预告过的内容」，等于把首页拉长一屏。 */}
  <section aria-labelledby="gates-h">
    <h2 id="gates-h">五门<small>今日皆开</small></h2>
    <ul class="gates">
      {
        gates.map((gate) => (
          <li>
            <a class="gate" href={gate.href}>
              <span class="gate__verb" aria-hidden="true">{gate.verb}</span>
              <img class="gate__name" src={gate.img} width={gate.w} height="80" alt="" />
              <span class="gate__desc">{gate.desc}</span>
              <span class="gate__go" aria-hidden="true">前往 →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {/* ③ 头版要闻：全站唯一一处「主条目」。一主两副，主条给标题与摘要，副条只给标题——
        邸报的完整正文在 /news，这里只负责把人勾过去。 */}
  {
    leadNews && (
      <section aria-labelledby="dibao-h">
        <h2 id="dibao-h">邸报头版<small>{dayCn}</small></h2>
        <div class="press">
          <a class="press__lead" href={leadNews.url}>
            <span class="press__seal" aria-hidden="true">头版</span>
            <span class="press__kicker">
              <em>{leadNews.source}</em>
              <i>{dibaoDate(leadNews.publishedAt)}</i>
            </span>
            <h3>{leadNews.title}</h3>
            {leadNews.summary && <p class="press__lede">{leadNews.summary}</p>}
            <span class="press__more">读原文 →</span>
          </a>
          <ul class="press__side">
            {
              sideNews.map((item) => (
                <li>
                  <a href={item.url}>
                    <span class="press__kicker">
                      <em>{item.source}</em>
                      <i>{dibaoDate(item.publishedAt)}</i>
                    </span>
                    <h3>{item.title}</h3>
                    <span class="press__more">读原文 →</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <p class="more"><a href="/news/">全部邸报 →</a></p>
      </section>
    )
  }

  {/* ④ 今日份口粮：全站票证的门面，四张铺满一行（沿用正式首页的定稿）。 */}
  <section aria-labelledby="home-tickets">
    <h2 id="home-tickets">今日份口粮<small>推荐分前 4</small></h2>
    <ul class="r4-stubs">
      {topTickets.map((t) => <li><TicketCard ticket={t} /></li>)}
    </ul>
    <p class="more"><a href="/tickets/">全部粮票 →</a></p>
  </section>

  {/* ⑤ 三榜并行：点将台 / 观星台 / 粮市并排收尾。把三个「查」的动作压进同一屏带，
        页面到此收口——再往下滚就没有新东西了，这是首页该有的尽头。 */}
  <section aria-labelledby="boards-h">
    <h2 id="boards-h">三榜并陈<small>今日各自榜首</small></h2>
    <div class="boards">
      <div class="board">
        <h3><a href="/models/">点将台 · 综合</a></h3>
        <ol class="board__list">
          {
            modelTop.map((row) => (
              <li>
                <a href="/models/">
                  <b class="board__no">{row.rank}</b>
                  <span class="board__name">{modelName(row)}</span>
                  <span class="board__val">{row.score}</span>
                  <span class="board__gap">{scoreGap(topScore, row.score)}</span>
                </a>
              </li>
            ))
          }
        </ol>
        <p class="board__foot"><a href="/models/">全部点将台 →</a></p>
      </div>

      <div class="board">
        <h3><a href="/github/">观星台 · 周榜</a></h3>
        <ol class="board__list">
          {
            ghTop.map((item, i) => (
              <li>
                <a href={item.url}>
                  <b class="board__no">{i + 1}</b>
                  <span class="board__name">{item.repo}</span>
                  <span class="board__val">{item.periodStars == null ? '—' : `+${thous(item.periodStars)}`}</span>
                  <span class="board__gap">{item.language ?? ''}</span>
                </a>
              </li>
            ))
          }
        </ol>
        <p class="board__foot"><a href="/github/">全部观星台 →</a></p>
      </div>

      {
        cheapPlans.length > 0 && (
          <div class="board">
            <h3><a href="/plans/">粮市 · 起步价最低</a></h3>
            <ol class="board__list">
              {
                cheapPlans.map((plan) => (
                  <li>
                    <a href={`/plans/${plan.id}/`}>
                      <b class="board__no">{planLead(plan)}</b>
                      <span class="board__name">{plan.product}</span>
                      <span class="board__val">{plan.vendor}</span>
                      <span class="board__gap">{startingPriceLabel(plan)}</span>
                    </a>
                  </li>
                ))
              }
            </ol>
            <p class="board__foot"><a href="/plans/">全部粮市 →</a></p>
          </div>
        )
      }
    </div>
  </section>
</Base>

<style>
  /* ── 头版 ─────────────────────────────────────────────── */
  .masthead {
    margin-bottom: 3rem;
  }

  .masthead__top {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* A 案实测：slogan 自然 685px 却只渲染 308px 挂在 1440 中间，两侧大片空黑。
     这里让它按视口长大，并把 glow 收窄一点免得糊。 */
  .masthead__slogan {
    width: clamp(260px, 42vw, 470px);
    height: auto;
    filter: drop-shadow(0 0 14px rgba(232, 183, 58, .38));
  }

  .masthead__stamp {
    position: absolute;
    right: 4%;
    top: 50%;
    translate: 0 -50%;
    rotate: -11deg;
    display: grid;
    gap: 2px;
    justify-items: center;
    padding: .5rem .7rem .45rem;
    font-family: var(--code);
    border: 2px solid rgba(200, 52, 42, .68);
    border-radius: 3px;
    box-shadow: 0 0 18px -6px rgba(200, 52, 42, .6);
  }

  .masthead__stamp b {
    font-family: var(--song);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: .18em;
    text-indent: .18em;
    color: rgba(200, 52, 42, .82);
  }

  .masthead__stamp i {
    font-style: normal;
    font-size: 12px;
    letter-spacing: .06em;
    color: rgba(200, 52, 42, .62);
  }

  .masthead__tagline {
    margin: .8rem 0 0;
    font-size: 12px;
    letter-spacing: .3em;
    text-indent: .3em;
    text-align: center;
    color: var(--dim);
  }

  /* 战报条：五格等分，格间一道细金线，像票证存根上的分栏。 */
  .report {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(9rem, 100%), 1fr));
    margin: 1.6rem 0 0;
    padding: 0;
    border: 1px solid var(--line-dim);
    border-radius: var(--radius);
    background: linear-gradient(180deg, rgba(232, 183, 58, .05), rgba(11, 9, 22, .45));
  }

  .report__cell {
    display: flex;
    flex-direction: column;
    gap: .3rem;
    padding: .85rem .3rem .9rem;
    text-align: center;
  }

  .report__cell + .report__cell {
    border-left: 1px solid var(--line-dim);
  }

  .report dt {
    font-size: 12px;
    letter-spacing: .16em;
    text-indent: .16em;
    color: var(--faint);
  }

  .report dd {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: .22rem;
    margin: 0;
    font-family: var(--code);
  }

  .report dd b {
    font-size: 26px;
    font-weight: 700;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    color: #ffe9c0;
    text-shadow: 0 0 16px rgba(232, 183, 58, .35);
  }

  .report dd span {
    font-size: 12px;
    color: var(--gold);
  }

  .report__cell p {
    margin: 0;
    font-family: var(--code);
    font-size: 12px;
    letter-spacing: .02em;
    color: var(--faint);
  }

  /* ── 五门 ─────────────────────────────────────────────── */
  h2 small {
    margin-left: .7rem;
    font-family: var(--code);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: .12em;
    color: var(--faint);
  }

  .gates {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gates > li {
    display: flex;
  }

  .gate {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: .5rem;
    width: 100%;
    padding: 1rem 1.05rem 1.05rem;
    color: inherit;
    text-decoration: none;
    border: 1px solid var(--line-dim);
    border-radius: var(--radius);
    background: linear-gradient(160deg, rgba(232, 183, 58, .07), rgba(11, 9, 22, .55));
    transition: border-color .2s ease, transform .2s ease, box-shadow .2s ease;
  }

  /* 左边一道竖向金边光，悬停时从中间向两端长满——与票卡同族的语言。 */
  .gate::before {
    content: "";
    position: absolute;
    left: 0;
    top: 22%;
    bottom: 22%;
    width: 2px;
    background: linear-gradient(180deg, transparent, var(--gold), transparent);
    opacity: .55;
    transition: top .25s ease, bottom .25s ease, opacity .2s ease;
  }

  .gate:hover {
    border-color: var(--gold);
    transform: translateY(-2px);
    box-shadow: 0 10px 28px -16px rgba(232, 183, 58, .7);
  }

  .gate:hover::before {
    top: 0;
    bottom: 0;
    opacity: 1;
  }

  .gate:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  /* 动词做成右上角的小钢印，而不是 A 案那种右对齐的孤零零一个字。 */
  .gate__verb {
    position: absolute;
    top: .8rem;
    right: .85rem;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    font-family: var(--song);
    font-size: 13px;
    font-weight: 700;
    color: var(--gold);
    border: 1px solid var(--line);
    border-radius: 2px;
    rotate: 6deg;
    opacity: .85;
  }

  .gate__name {
    height: 28px;
    width: auto;
    filter: drop-shadow(0 0 8px rgba(232, 183, 58, .3));
  }

  .gate__desc {
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--dim);
  }

  .gate__go {
    margin-top: .2rem;
    font-size: 12px;
    letter-spacing: .14em;
    color: var(--faint);
    transition: color .18s ease;
  }

  .gate:hover .gate__go {
    color: var(--gold);
  }

  /* ── 头版要闻 ─────────────────────────────────────────── */
  .press {
    display: grid;
    gap: 1rem;
    align-items: stretch;
  }

  .press__lead {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.3rem 1.4rem 1.25rem;
    color: inherit;
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background:
      radial-gradient(120% 130% at 100% 0%, rgba(232, 183, 58, .1), transparent 62%),
      rgba(11, 9, 22, .5);
    transition: border-color .2s ease, transform .2s ease, box-shadow .2s ease;
  }

  .press__lead:hover {
    border-color: var(--gold);
    transform: translateY(-2px);
    box-shadow: 0 12px 30px -18px rgba(232, 183, 58, .65);
  }

  .press__seal {
    position: absolute;
    top: 1.15rem;
    right: 1.3rem;
    padding: .2rem .4rem;
    font-family: var(--song);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .12em;
    text-indent: .12em;
    color: rgba(200, 52, 42, .82);
    border: 2px solid rgba(200, 52, 42, .6);
    border-radius: 2px;
    rotate: -9deg;
  }

  .press__kicker {
    display: flex;
    align-items: baseline;
    gap: .6rem;
    font-family: var(--code);
    font-size: 12px;
  }

  .press__kicker em {
    font-style: normal;
    letter-spacing: .1em;
    color: var(--cyan);
  }

  .press__kicker i {
    font-style: normal;
    color: var(--faint);
  }

  .press__lead h3 {
    margin: .55rem 4.5rem .5rem 0;
    font-size: 21px;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: .02em;
    color: #ffe9c0;
    transition: color .18s ease;
  }

  .press__lead:hover h3 {
    color: #fff;
  }

  .press__lede {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
    font-size: 13px;
    line-height: 1.85;
    color: var(--dim);
  }

  .press__more {
    display: inline-block;
    margin-top: auto;
    padding-top: .7rem;
    align-self: flex-start;
    font-size: 12px;
    letter-spacing: .16em;
    color: var(--gold);
    transition: color .18s ease;
  }

  .press a:hover .press__more {
    color: #fff;
  }

  .press__side {
    display: grid;
    gap: .8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .press__side a {
    position: relative;
    display: block;
    height: 100%;
    padding: .95rem 1.05rem 1rem;
    color: inherit;
    text-decoration: none;
    border: 1px solid var(--line-dim);
    border-left: 2px solid var(--cyan);
    border-radius: var(--radius);
    background: rgba(11, 9, 22, .42);
    transition: border-color .2s ease, background .2s ease;
  }

  .press__side a:hover {
    background: rgba(11, 9, 22, .7);
    border-left-color: var(--cyan);
  }

  .press__side h3 {
    margin: .45rem 0 0;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.6;
    color: var(--text);
    transition: color .18s ease;
  }

  .press__side a:hover h3 {
    color: #fff;
  }

  /* ── 三榜 ─────────────────────────────────────────────── */
  .boards {
    display: grid;
