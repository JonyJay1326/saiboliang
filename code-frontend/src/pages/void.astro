---
// /void 已失效票墙 —— frontend-spec §4.8
// 进入条件唯一：expired === true。只有一组，不再区分「已兑付 / 已作废」。
// 排序：有 expiryDate 的按 expiryDate 降序在前，null 的在后，再按 id 升序（契约 §4.2）。
import Base from '../layouts/Base.astro';
import TicketCard from '../components/TicketCard.vue';
import { tickets } from '../lib/data.js';

const file = tickets();
const list = file.tickets
  .filter((t) => t.expired === true)
  .sort((a, b) => {
    const ax = a.expiryDate;
    const bx = b.expiryDate;
    if (ax && bx && ax !== bx) return ax < bx ? 1 : -1;
    if (ax && !bx) return -1;
    if (!ax && bx) return 1;
    return a.id < b.id ? -1 : 1;
  });
---
<Base
  title="已失效票墙"
  description="已经领不到的免费额度与试用活动。"
  dataUpdatedAt={file.dataUpdatedAt}
>
  <h1>已失效票墙</h1>
  <p>这些已经领不到了。</p>

  {
    list.length === 0 ? (
      <p>暂无已失效票证。</p>
    ) : (
      <ul class="cards">
        {list.map((t) => <li><TicketCard ticket={t} /></li>)}
      </ul>
    )
  }
</Base>
