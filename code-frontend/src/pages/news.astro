---
// /news 邸报 —— frontend-spec.md §4.7（2026-09-20 用户解封：资讯提前放开，按给定参考图落版）
// 版式：页头（板块名 + 题头）→ 按北京时间自然日分组的条目列：
// 左侧日期栏（竖排中文日期）+ 竖向细线，右侧标题与来路行；
// 条目间虚线分隔、跨日压红线断开。窄屏日期栏改横向分隔条，正文占满宽度。
// 数据：news.json（契约 §4.5 news v2）构建期注入；条目永久累加，按 publishedAt 降序、id 升序。
// 版权纪律（§10.1 约束 #6）：只展示标题 + 短摘要 + 来路 + 跳转，不存正文、不提供站内阅读。
import Base from '../layouts/Base.astro';
import { news } from '../lib/data.js';
import { EVENT_TYPE } from '../lib/labels.js';
import { addedWithinDays, dibaoDate, toBeijing } from '../lib/format.js';

const file = news();

// 契约 §4.5：列表只展示当日精选（`featured` 为 true）；未入选条目仍永久累加在数据文件里，不展示。
const items = [...file.items].filter((item) => item.featured === true).sort((a, b) => {
  if (a.publishedAt !== b.publishedAt) return a.publishedAt < b.publishedAt ? 1 : -1;
  return a.id < b.id ? -1 : 1;
});

// 按北京时间自然日分组：一天一格日期，同日多条共用一个日期。
// 日期栏顺带产出锚点 id 与短标签（9/23），给右侧「日期跳转」用（2026-09-23 UI 审查 01）。
const days = [];
for (const item of items) {
  const key = toBeijing(item.publishedAt)?.slice(0, 10) ?? '';
  const last = days.at(-1);
  if (last && last.key === key) last.items.push(item);
  else {
    const [, month, date] = key.split('-');
    days.push({
      key,
      label: dibaoDate(item.publishedAt) ?? '日期未提供',
      short: key ? `${Number(month)}/${Number(date)}` : '—',
      items: [item],
    });
  }
}

// 本期提要（2026-09-21 用户确认「按 §4.7 优化」）：全部是前端只读派生，不入库、不新增字段。
// 事件类型分布只统计本期已渲染条目；近七日入库按 addedAt 统计**全部**条目（含未入选），
// 用来表达产出节奏，不是展示范围。
const typeCounts = Object.entries(
  items.reduce((acc, item) => {
    const key = item.eventType ?? 'unknown';
    acc[key] = (acc[key] ?? 0) + 1;
    return acc;
  }, {})
)
  .map(([key, count]) => ({ key, label: EVENT_TYPE[key] ?? key, count }))
  .sort((a, b) => b.count - a.count || (a.key < b.key ? -1 : 1));

const recentCount = addedWithinDays(file.items, 7, file.dataUpdatedAt);

// 来路（契约 §4.5 跳转规则 / frontend-spec §5.5）：
// 官方直采 = 三链同值，合并为一个「官方原文」入口；媒体条目有已核实一手 → 标题直达一手、
// 另附「中文报道」；无可靠一手 → 标题直达报道，标签仍写「中文报道」、未核实信息放悬停提示。
//
// 2026-09-23 UI 审查 02：未核实状态不再只藏在 title 悬停里——`.dibao__tag` 在来源行常显
// 「二手 · 一手未核实」，同时作为筛选维度之一（下方轻筛只控制已渲染条目的显隐）。
function entryLink(item) {
  const official =
    item.originalUrl !== null && item.originalUrl === item.sourceUrl && item.sourceUrl === item.url;
  if (official) return { href: item.url, label: '官方原文', title: null, verify: 'official' };
  if (item.originalUrl) return { href: item.sourceUrl, label: '中文报道', title: null, verify: 'press' };
  return { href: item.sourceUrl, label: '中文报道', title: '未核实一手来源', verify: 'unverified' };
}

// 轻筛维度（2026-09-23 UI 审查 01）：按事件类型 + 按来路可靠度，两组都只筛页面已渲染的条目。
// 计数一律现算，不入库、不改契约（同 §4.7 只读派生纪律）。
const VERIFY_LABEL = { official: '官方原文', press: '中文报道已核实', unverified: '二手 · 一手未核实' };
const verifyCounts = items.reduce((acc, item) => {
  const key = entryLink(item).verify;
  acc[key] = (acc[key] ?? 0) + 1;
  return acc;
}, {});
const verifyFilters = ['official', 'press', 'unverified']
  .filter((key) => verifyCounts[key])
  .map((key) => ({ key, label: VERIFY_LABEL[key], count: verifyCounts[key] }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  inLanguage: 'zh-CN',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'NewsArticle',
      headline: item.title,
      url: item.url,
      datePublished: item.publishedAt,
      publisher: { '@type': 'Organization', name: item.source },
    },
  })),
};
---
<Base
  title="邸报"
  description="AI 中文资讯精选：只记标题与来路，按发布时间倒序，点击标题直达原文。"
  dataUpdatedAt={file.dataUpdatedAt}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <header class="dibao-head">
    <h1 class="page-title">
      <img src="/font-images/sec-dibao.png" width="161" height="80" alt="邸报" />
    </h1>
    <p class="dibao-head__tagline">朝廷大事 · 每日一抄</p>
  </header>

  {items.length === 0 ? (
    <p class="dibao__empty">本期暂无邸报</p>
  ) : (
    <div class="dibao-wrap" data-dibao>
      <ol class="dibao">
        {days.map((day) => (
          <li class="dibao__day" id={`dibao-${day.key}`} data-dibao-day>
            <time class="dibao__date" datetime={day.key || undefined}>
              <span class="dibao__date-day">{day.label}</span>
            </time>
            <ol class="dibao__items">
              {day.items.map((item) => {
                const link = entryLink(item);
                return (
                  <li class="dibao__item" data-dibao-item data-dibao-event={item.eventType ?? 'unknown'} data-dibao-verify={link.verify}>
                    <h2 class="dibao__title">
                      <a href={item.url} target="_blank" rel="noopener noreferrer">
                        {item.title}
                      </a>
                    </h2>
                    {item.summary && <p class="dibao__summary">{item.summary}</p>}
                    <p class="dibao__meta">
                      <span class="dibao__facts">
                        <span class="dibao__badge">{EVENT_TYPE[item.eventType] ?? item.eventType}</span>
                        <span class="dibao__time">{toBeijing(item.publishedAt)?.slice(11)}</span>
                        <span class="dibao__source">{item.source}</span>
                      </span>
                      <span class="dibao__links">
                        <a
                          class="dibao__link"
                          href={link.href}
                          target="_blank"
                          rel="noopener noreferrer"
                          title={link.title}
                        >
                          {link.label}
                        </a>
                        {link.verify === 'unverified' && (
                          <span class="dibao__flag dibao__flag--warn">
                            <span class="dibao__tag dibao__tag--warn" title={link.title}>
                              二手 · 一手未核实
                            </span>
                          </span>
                        )}
                        {item.originalTitle && (
                          <span class="dibao__flag">
                            <span class="dibao__tag" title={item.originalTitle}>
                              机译
                            </span>
                          </span>
                        )}
                      </span>
                    </p>
                  </li>
                );
              })}
            </ol>
          </li>
        ))}
      </ol>

      {/* 本期提要：只读派生计数 + 日期索引 + 事件/来路轻筛（frontend-spec §4.7）。
          轻筛只控制已渲染条目的显隐，不重排数据、不改契约；无 JS 时全部条目照常可见。 */}
      <aside class="dibao-rail" aria-labelledby="dibao-rail-title">
        <h2 class="dibao-rail__title" id="dibao-rail-title">本期提要</h2>
        <dl class="dibao-rail__list">
          <div class="dibao-rail__lead">
            <dt>本期条目</dt>
            <dd>{items.length}</dd>
          </div>
          <div class="dibao-rail__lead">
            <dt>覆盖天数</dt>
            <dd>{days.length}</dd>
          </div>
        </dl>
        <p class="dibao-rail__foot">
          近七日入库<b>{recentCount}</b> 条
        </p>

        <div class="dibao-rail__block">
          <h3 class="dibao-rail__h">日期跳转</h3>
          <ul class="dibao-days">
            {days.map((day) => (
              <li><a href={`#dibao-${day.key}`} title={`跳至 ${day.key}`}>{day.short}</a></li>
            ))}
          </ul>
        </div>

        <div class="dibao-rail__block">
          <h3 class="dibao-rail__h">按事件筛</h3>
          <div class="dibao-filter">
            <button type="button" data-dibao-filter="all" aria-pressed="true">全部 {items.length}</button>
            {typeCounts.map((type) => (
              <button type="button" data-dibao-filter={`event:${type.key}`} aria-pressed="false">
                {type.label} {type.count}
              </button>
            ))}
          </div>
        </div>

        <div class="dibao-rail__block">
          <h3 class="dibao-rail__h">按来路筛</h3>
          <div class="dibao-filter">
            {verifyFilters.map((v) => (
              <button type="button" data-dibao-filter={`verify:${v.key}`} aria-pressed="false">
                {v.label} {v.count}
              </button>
            ))}
          </div>
        </div>

        <p class="dibao-rail__count" data-dibao-count aria-live="polite">共 {items.length} 条</p>
      </aside>
    </div>
  )}

  {/* 邸报轻筛（2026-09-23 UI 审查 01）：不加依赖、不进首屏 JS 之外——一段行内委托脚本，
      只切已渲染条目的 hidden、并同步空日与计数；不做滚动加载（列表已能按日/类定位，
      85 条一次性渲染对 SEO 与无 JS 环境都更稳）。 */}
  <script is:inline>
    document.addEventListener('click', (event) => {
      const btn = event.target instanceof Element ? event.target.closest('[data-dibao-filter]') : null;
      const root = btn?.closest('[data-dibao]');
      if (!root) return;
      const value = btn.dataset.dibaoFilter;
      for (const b of root.querySelectorAll('[data-dibao-filter]')) {
        b.setAttribute('aria-pressed', String(b === btn));
      }
      let shown = 0;
      for (const item of root.querySelectorAll('[data-dibao-item]')) {
        const ok =
          value === 'all' ||
          (value.startsWith('event:') && item.dataset.dibaoEvent === value.slice(6)) ||
          (value.startsWith('verify:') && item.dataset.dibaoVerify === value.slice(7));
        item.hidden = !ok;
        if (ok) shown += 1;
      }
      for (const day of root.querySelectorAll('[data-dibao-day]')) {
        day.hidden = !day.querySelector('[data-dibao-item]:not([hidden])');
      }
      const count = root.querySelector('[data-dibao-count]');
      if (count) {
        const total = root.querySelectorAll('[data-dibao-item]').length;
        count.textContent = shown === total ? `共 ${total} 条` : `筛选后 ${shown} 条 / 共 ${total} 条`;
      }
    });
  </script>
</Base>
