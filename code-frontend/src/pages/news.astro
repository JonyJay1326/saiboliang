---
// /news 邸报 —— frontend-spec.md §4.7（2026-09-20 用户解封：资讯提前放开，按给定参考图落版）
// 版式：页头（板块名 + 题头）→ 按北京时间自然日分组的条目列：
// 左侧日期栏（竖排中文日期 + 本日条数，兼作报头）+ 竖向细线，右侧标题与来路行；
// 条目间虚线分隔、跨日压红线断开。窄屏日期栏改横向分隔条，正文占满宽度。
// 数据：news.json（契约 §4.5 news v2）构建期注入；条目永久累加，按 publishedAt 降序、id 升序。
// 版权纪律（§10.1 约束 #6）：只展示标题 + 短摘要 + 来路 + 跳转，不存正文、不提供站内阅读。
import Base from '../layouts/Base.astro';
import { news } from '../lib/data.js';
import { EVENT_TYPE } from '../lib/labels.js';
import { dibaoDate, toBeijing } from '../lib/format.js';

const file = news();

// 契约 §4.5：排序为 publishedAt 降序、id 升序（管道已排，此处兜底、只读派生）。
const items = [...file.items].sort((a, b) => {
  if (a.publishedAt !== b.publishedAt) return a.publishedAt < b.publishedAt ? 1 : -1;
  return a.id < b.id ? -1 : 1;
});

// 按北京时间自然日分组：一天一格日期，同日多条共用一个日期。
const days = [];
for (const item of items) {
  const key = toBeijing(item.publishedAt)?.slice(0, 10) ?? '';
  const last = days.at(-1);
  if (last && last.key === key) last.items.push(item);
  else days.push({ key, label: dibaoDate(item.publishedAt) ?? '日期未提供', items: [item] });
}

// 来路（契约 §4.5 跳转规则 / frontend-spec §5.5）：
// 官方直采 = 三链同值，合并为一个「官方原文」入口；媒体条目有已核实一手 → 标题直达一手、
// 另附「中文报道」；无可靠一手 → 标题直达报道，标签仍写「中文报道」、未核实信息放悬停提示。
function entryLink(item) {
  const official =
    item.originalUrl !== null && item.originalUrl === item.sourceUrl && item.sourceUrl === item.url;
  if (official) return { href: item.url, label: '官方原文', title: null };
  if (item.originalUrl) return { href: item.sourceUrl, label: '中文报道', title: null };
  return { href: item.sourceUrl, label: '中文报道', title: '未核实一手来源' };
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  inLanguage: 'zh-CN',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'NewsArticle',
      headline: item.title,
      url: item.url,
      datePublished: item.publishedAt,
      publisher: { '@type': 'Organization', name: item.source },
    },
  })),
};
---
<Base
  title="邸报"
  description="AI 中文资讯精选：只记标题与来路，按发布时间倒序，点击标题直达原文。"
  dataUpdatedAt={file.dataUpdatedAt}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <header class="dibao-head">
    <h1 class="page-title">
      <img src="/font-images/sec-dibao.png" width="161" height="80" alt="邸报" />
    </h1>
    <p class="dibao-head__tagline">朝廷大事 · 每日一抄</p>
  </header>

  {items.length === 0 ? (
    <p class="dibao__empty">本期暂无邸报</p>
  ) : (
    <ol class="dibao">
      {days.map((day) => (
        <li class="dibao__day">
          <time class="dibao__date" datetime={day.key || undefined}>
            <span class="dibao__date-day">{day.label}</span>
            <span class="dibao__date-count">本日 {day.items.length} 则</span>
          </time>
          <ol class="dibao__items">
            {day.items.map((item) => {
              const link = entryLink(item);
              return (
                <li class="dibao__item">
                  <h2 class="dibao__title">
                    <a href={item.url} target="_blank" rel="noopener noreferrer">
                      {item.title}
                    </a>
                  </h2>
                  {item.summary && <p class="dibao__summary">{item.summary}</p>}
                  <p class="dibao__meta">
                    <span class="dibao__facts">
                      <span class="dibao__badge">{EVENT_TYPE[item.eventType] ?? item.eventType}</span>
                      <span class="dibao__time">{toBeijing(item.publishedAt)?.slice(11)}</span>
                      <span class="dibao__source">{item.source}</span>
                    </span>
                    <span class="dibao__links">
                      <a
                        class="dibao__link"
                        href={link.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        title={link.title}
                      >
                        {link.label}
                      </a>
                      {item.originalTitle && (
                        <span class="dibao__flag">
                          <span class="dibao__tag" title={item.originalTitle}>
                            机译
                          </span>
                        </span>
                      )}
                    </span>
                  </p>
                </li>
              );
            })}
          </ol>
        </li>
      ))}
    </ol>
  )}
</Base>
