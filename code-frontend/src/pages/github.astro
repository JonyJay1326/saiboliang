---
// /github 观星台 —— frontend-spec §4.4
// 周/月切换为轻量显隐（原生脚本，见 §7.1 / §10.2），两榜均在构建期渲染。
// 默认周榜。
import Base from '../layouts/Base.astro';
import GithubRow from '../components/GithubRow.astro';
import ToggleBar from '../components/ToggleBar.astro';
import { github } from '../lib/data.js';
import { toBeijing } from '../lib/format.js';

const file = github();
const DEFAULT = 'week';
const boards = [
  { key: 'week', label: '周榜', data: file.week },
  { key: 'month', label: '月榜', data: file.month },
];
---
<Base
  title="观星台"
  description="GitHub Trending AI 热门精选，按区间新增 star 降序。"
  dataUpdatedAt={file.dataUpdatedAt}
>
  <h1 class="page-title">
    <img src="/font-images/sec-guanxing.png" width="228" height="80" alt="观星台" />
  </h1>
  <p>GitHub Trending · AI 热门精选。区间由 GitHub 定义，不标本站精确 7/30 天净增。</p>

  <div data-toggle data-toggle-current={DEFAULT}>
    <ToggleBar label="榜单周期" options={boards} current={DEFAULT} />

    {
      boards.map((board) => (
        <section data-toggle-panel={board.key} hidden={board.key !== DEFAULT}>
          <h2>{board.label}</h2>
          <p>
            来源{' '}
            <a href={board.data.sourceUrl} target="_blank" rel="noopener noreferrer">
              {board.data.sourceUrl}
            </a>
            {board.data.fetchedAt && ` · 抓取于 ${toBeijing(board.data.fetchedAt)}`}
          </p>
          {board.data.items.length === 0 ? (
            <p>本期暂无符合条件的项目</p>
          ) : (
            <ol class="ranking">
              {board.data.items.map((item, i) => (
                <GithubRow item={item} index={i + 1} />
              ))}
            </ol>
          )}
        </section>
      ))
    }
  </div>
</Base>
