---
// /collection 我的粮票 —— frontend-spec §4.9 / §7.3
// 纯本机：localStorage，无后端、无登录。真实渲染由客户端完成，
// 但票证数据随页面构建期注入（供「已下架」判断），不额外拉取。
import Base from '../layouts/Base.astro';
import { tickets } from '../lib/data.js';

const file = tickets();
const index = Object.fromEntries(
  file.tickets.map((t) => [t.id, { title: t.title, vendor: t.vendor, expired: t.expired }])
);
---
<Base
  title="我的粮票"
  description="本机收藏册，记录只存在这台设备上。"
  dataUpdatedAt={file.dataUpdatedAt}
>
  <h1>我的粮票</h1>

  <div data-collection data-ticket-index={JSON.stringify(index)}>
    <p data-collection-empty>还没领过粮。看到合适的，盖个戳。</p>
    <ul data-collection-list hidden></ul>
  </div>

  <p><button type="button" data-collection-export>导出 JSON</button></p>
  <p>记录只存在这台设备上，清缓存会丢。</p>
</Base>

<script is:inline>
  // 收藏册（frontend-spec §7.3）：key = cg:collection，value = { id: { claimedAt } }
  if (!window.__cgCollection) {
    window.__cgCollection = true;
    const KEY = 'cg:collection';

    const read = () => {
      try {
        const raw = localStorage.getItem(KEY);
        const parsed = raw ? JSON.parse(raw) : {};
        return parsed && typeof parsed === 'object' ? parsed : {};
      } catch {
        return {};
      }
    };

    const write = (value) => {
      try {
        localStorage.setItem(KEY, JSON.stringify(value));
        return true;
      } catch {
        window.alert('无法写入本机存储，收藏可能不会被保存。');
        return false;
      }
    };

    const render = () => {
      const host = document.querySelector('[data-collection]');
      if (!host) return;
      let index = {};
      try {
        index = JSON.parse(host.dataset.ticketIndex || '{}');
      } catch {
        index = {};
      }
      const owned = read();
      const list = host.querySelector('[data-collection-list]');
      const empty = host.querySelector('[data-collection-empty]');
      const ids = Object.keys(owned).sort((a, b) =>
        String(owned[a].claimedAt).localeCompare(String(owned[b].claimedAt))
      );

      list.textContent = '';
      for (const id of ids) {
        const li = document.createElement('li');
        const known = index[id];
        if (!known) {
          // 已下架占位：不把旧收藏误映射到新活动（§4.9 第 5 块）
          li.textContent = `${id}（已下架）`;
        } else {
          const a = document.createElement('a');
          a.href = `/tickets/${id}/`;
          a.textContent = `${known.title} · ${known.vendor}`;
          li.appendChild(a);
        }
        list.appendChild(li);
      }
      const has = ids.length > 0;
      list.hidden = !has;
      empty.hidden = has;
    };

    document.addEventListener('astro:page-load', render);
    window.addEventListener('storage', render);

    document.addEventListener('click', (event) => {
      if (event.target.closest('[data-collection-export]')) {
        const blob = new Blob([JSON.stringify(read(), null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'saiboliang-collection.json';
        a.click();
        URL.revokeObjectURL(url);
      }
    });
  }
</script>
