---
import Base from '../layouts/Base.astro';
import TicketCard from '../components/TicketCard.astro';
import ModelPodium from '../components/ModelPodium.astro';
import ModelRollRow from '../components/ModelRollRow.astro';
import PlanCard from '../components/PlanCard.astro';
import GithubLedgerRow from '../components/GithubLedgerRow.astro';
import { marketDomain } from '../lib/stubs.js';
import { github, models, tickets } from '../lib/data.js';
import { freshness, planStatusLabel, thous, toBeijing, scoreTier } from '../lib/format.js';
import { homeContent, homePlanPrice } from '../lib/home.js';
import '../styles/home.css';

const modelFile = models();
const { listed, headTicket, restTickets, markets, marketTop, ghTop, modelTop, modelById, oldest } = homeContent(tickets(), modelFile, github());
const state = freshness(oldest);
const firstModel = modelTop[0];
const leadingModel = firstModel ? modelById.get(firstModel.modelId) : null;
const eastPlan = marketTop.find((plan) => plan.group === 'domestic');
const westPlan = marketTop.find((plan) => plan.group === 'overseas');
const firstRepo = ghTop[0];
const wall = headTicket ? [headTicket, ...restTickets] : restTickets;
// 下方三块直接复用各专页的组件与样式（点将台 / 粮市 / 观星台），首页只截取前几名
const modelRows = modelTop.map((row) => ({ ...row, model: modelById.get(row.modelId) ?? null }));
const domainOf = Object.fromEntries(markets.map((market) => [market.group, marketDomain(market.items)]));
const planWall = marketTop.slice(0, 4);
const repoRows = ghTop.slice(0, 6);
const stats = [
  { value: listed.length, unit: '张', label: '在架粮票' },
  { value: (modelFile.rankings?.intelligence ?? []).length, unit: '将', label: '点将台在册' },
  { value: (modelFile.plans ?? []).length, unit: '档', label: '东西两市套餐' },
  { value: ghTop.length, unit: '星', label: '本周星历' },
];
// 行情跑马灯：只是下方真实字段的滚动预览，完整数据与出处在各分区与专页
const tape = [
  ...modelTop.map((row) => { const model = modelById.get(row.modelId); return { tag: '点将', text: model?.name ?? row.modelId, value: `AA ${row.score}`, tone: 'gold' }; }),
  ...marketTop.map((plan) => ({ tag: plan.group === 'domestic' ? '东市' : '西市', text: plan.product, value: homePlanPrice(plan), tone: plan.group === 'domestic' ? 'ver' : 'cyan' })),
  ...ghTop.slice(0, 6).map((repo) => ({ tag: '观星', text: repo.repo, value: repo.periodStars == null ? '—' : `+${thous(repo.periodStars)}★`, tone: 'cyan' })),
  ...listed.slice(0, 6).map((ticket) => ({ tag: '粮票', text: `${ticket.vendor} · ${ticket.title}`, value: `${scoreTier(ticket.score)}等`, tone: 'gold' })),
];
---
<Base description="大厂开仓，凭票领饭。找到 AI 免费额度，比较模型能力与编程套餐，发现开源好工具。" dataUpdatedAt={oldest}>
  <div class="granary" data-granary>
    <section class="taicang" data-coin-stage aria-labelledby="home-title">
      <canvas class="taicang__canvas" data-coin-canvas aria-hidden="true"></canvas>
      <div class="taicang__grid" aria-hidden="true"></div>
      <div class="taicang__inner">
        <div class="taicang__copy">
          <p class="taicang__kicker"><span class="taicang__pulse" aria-hidden="true"></span><span data-decode>TAICANG // 太仓 · 全站总仓</span></p>
          <h1 id="home-title" class="taicang__title"><img src="/font-images/slogan.png" width="685" height="80" alt="大厂开仓，凭票领饭" fetchpriority="high" /><span class="taicang__title-shine" aria-hidden="true"></span></h1>
          <p class="taicang__lede">AI 免费额度、模型能力与编程套餐，<br />逐张核验，<em>凭票领粮</em>，按需挑选。</p>
          <div class="taicang__actions">
            <a class="grain-button" href="/tickets/">领粮票 <span aria-hidden="true">›</span></a>
            <a class="taicang__ghost" href="#granary-intel">看行情 <span aria-hidden="true">↓</span></a>
          </div>
          <dl class="taicang__stats">{stats.map((stat) => <div><dt>{stat.label}</dt><dd><strong data-count={stat.value}>{stat.value}</strong><small>{stat.unit}</small></dd></div>)}</dl>
          <a href="/about/" class="taicang__fresh" data-level={state.level}>数据核验 <time datetime={oldest ?? undefined}>{toBeijing(oldest) ?? '尚未核验'}</time>{state.level !== 'ok' && <span class="taicang__fresh-stale" role="status">{state.text}</span>}</a>
        </div>
        <div class="taicang__coin" data-coin-anchor aria-hidden="true">
          <svg class="taicang__dial" viewBox="0 0 400 400"><circle cx="200" cy="200" r="196" /><circle class="taicang__dial-ticks" cx="200" cy="200" r="186" /><circle class="taicang__dial-arc" cx="200" cy="200" r="176" /></svg>
          <div class="taicang__fallback"><img src="/font-images/brand.png" width="753" height="184" alt="" loading="lazy" /></div>
          <span class="taicang__hud taicang__hud--tl"><b data-coin-label>太仓 · 赛博粮站通宝</b></span>
          <span class="taicang__hud taicang__hud--br" data-coin-hint>拨动粮粒 · 点击放粮</span>
        </div>
      </div>
      <nav class="taicang__doors" aria-label="先看看行情">
        <a href="/models/" class="taicang-door" data-form="models" data-etched>
          <span class="taicang-door__badge" aria-hidden="true"><svg viewBox="0 0 48 48"><use href="#station-glyph-3" /></svg></span>
          <span class="taicang-door__body">
            <span class="taicang-door__label">点将台</span>
            <strong>{leadingModel?.name ?? firstModel?.modelId ?? '模型榜待更新'}</strong>
            <span class="taicang-door__meta">{firstModel ? `综合榜首 · AA ${firstModel.score}` : '等待来源恢复'}</span>
          </span>
          <span class="taicang-door__go" aria-hidden="true">→</span>
        </a>
        <a href="/plans/" class="taicang-door" data-form="plans" data-etched>
          <span class="taicang-door__badge" aria-hidden="true"><svg viewBox="0 0 48 48"><use href="#station-glyph-4" /></svg></span>
          <span class="taicang-door__body">
            <span class="taicang-door__label">东西粮市</span>
            <strong>{eastPlan?.product ?? '东市暂无套餐'}</strong>
            <span class="taicang-door__meta">{eastPlan ? `${homePlanPrice(eastPlan)}${eastPlan.source === 'aggregator' ? ' · 第三方整理价' : ''}${eastPlan.status !== 'available' ? ` · ${planStatusLabel(eastPlan.status)}` : ''}` : '等待收录'}</span>
          </span>
          <span class="taicang-door__go" aria-hidden="true">→</span>
        </a>
        <a href="/github/" class="taicang-door" data-form="github" data-etched>
          <span class="taicang-door__badge" aria-hidden="true"><svg viewBox="0 0 48 48"><use href="#station-glyph-2" /></svg></span>
          <span class="taicang-door__body">
            <span class="taicang-door__label">观星台</span>
            <strong>{firstRepo?.repo ?? '开源榜待更新'}</strong>
            <span class="taicang-door__meta">{firstRepo ? (firstRepo.periodStars == null ? '周新增未提供' : `周新增 +${thous(firstRepo.periodStars)} ★`) : '等待来源恢复'}</span>
          </span>
          <span class="taicang-door__go" aria-hidden="true">→</span>
        </a>
      </nav>
    </section>

    {tape.length > 0 && <div class="granary-tape" aria-hidden="true"><div class="granary-tape__track">{[0, 1].map(() => <div class="granary-tape__run">{tape.map((item) => <span class={`granary-tape__item granary-tape__item--${item.tone}`}><b>{item.tag}</b>{item.text}<em>{item.value}</em></span>)}</div>)}</div></div>}

    <section class="granary-board granary-rations" aria-labelledby="home-tickets" data-reveal>
      <header class="granary-section-head">
        <h2 id="home-tickets"><img src="/font-images/sec-liangpiao.png" width="153" height="80" alt="粮票" loading="lazy" /></h2>
        <a class="grain-text-link" href="/tickets/">全部 {listed.length} 张 <span aria-hidden="true">↗</span></a>
      </header>
      {!headTicket && <div class="granary-empty"><h3>{listed.length ? '暂无符合推荐条件的主票' : '本期空仓'}</h3><p>先看看其余粮票，或去点将台挑选模型。</p><a href="/models/">前往点将台 ↗</a></div>}
      {wall.length > 0 && <ul class="r4-stubs granary-ticket-wall">
        {wall.map((ticket, index) => <li class={headTicket && index === 0 ? 'granary-featured' : undefined}>{headTicket && index === 0 && <span class="granary-featured__flag">本期主粮</span>}<TicketCard ticket={ticket} index={index} /></li>)}
      </ul>}
    </section>

    <section class="granary-board" id="granary-intel" aria-labelledby="home-models" data-reveal>
      <header class="granary-section-head">
        <h2 id="home-models"><img src="/font-images/sec-jiang.png" width="226" height="80" alt="点将台" loading="lazy" /></h2>
        <a class="grain-text-link" href="/models/">完整榜单 <span aria-hidden="true">↗</span></a>
      </header>
      {modelRows.length === 0 ? <p class="granary-empty">模型榜暂未提供，等待来源恢复。</p> : <>
        <div class="podium">{modelRows.slice(0, 3).map((g) => <ModelPodium row={g} model={g.model} />)}</div>
        {modelRows.length > 3 && <div class="roll">
          <div class="roll__head" aria-hidden="true">
            <span>座次<em>排名</em></span>
            <span>名将<em>模型</em></span>
            <span>入营<em>上线</em></span>
            <span>俸禄<em>输入 / 输出</em></span>
            <span class="roll__num">战力<em>AA 分</em></span>
            <span class="roll__num">距榜首<em>分差</em></span>
          </div>
          <ol class="roll__rows">{modelRows.slice(3).map((g) => <ModelRollRow row={g} model={g.model} topScore={modelRows[0].score} />)}</ol>
        </div>}
      </>}
    </section>

    <section class="granary-board" aria-labelledby="home-plans" data-reveal>
      <header class="granary-section-head">
        <h2 id="home-plans"><img src="/font-images/sec-shi.png" width="157" height="80" alt="粮市" loading="lazy" /></h2>
        <a class="grain-text-link" href="/plans/">逛逛粮市 <span aria-hidden="true">↗</span></a>
      </header>
      {planWall.length === 0 ? <p class="granary-empty">本期暂无套餐，等待收录。</p> : <ul class="r4-stubs r4-stubs--plan granary-plan-wall">
        {planWall.map((plan, index) => <li><PlanCard plan={plan} index={index + 1} domain={domainOf[plan.group]} /></li>)}
      </ul>}
    </section>

    <section class="granary-board" aria-labelledby="home-github" data-reveal>
      <header class="granary-section-head">
        <h2 id="home-github"><img src="/font-images/sec-guanxing.png" width="228" height="80" alt="观星台" loading="lazy" /></h2>
        <a class="grain-text-link" href="/github/">完整星历 <span aria-hidden="true">↗</span></a>
      </header>
      {repoRows.length === 0 ? <p class="granary-empty">开源榜暂未提供，等待来源恢复。</p> : <div class="ledger">
        <ol>{repoRows.map((item, index) => <GithubLedgerRow item={item} index={index + 1} />)}</ol>
      </div>}
    </section>

    <section class="granary-outro" aria-labelledby="granary-outro-title" data-reveal>
      <img class="granary-outro__seal" src="/font-images/sec-yichuan.png" width="158" height="80" alt="" loading="lazy" />
      <div><p class="granary-kicker">好粮不独享</p><h2 id="granary-outro-title">发现好机会，给大伙儿捎一份。</h2></div>
      <a href="/tip/" class="grain-button">驿传 · 报 <span aria-hidden="true">›</span></a>
    </section>
  </div>
</Base>
<script>
  import { mountHome } from '../scripts/home-stage.js';
  let release: () => void = () => {};
  document.addEventListener('astro:before-swap', () => { release(); release = () => {}; });
  document.addEventListener('astro:page-load', () => { release(); release = mountHome(); });
  release = mountHome();
</script>
