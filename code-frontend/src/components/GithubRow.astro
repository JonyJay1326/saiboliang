---
// GitHub 榜单行（frontend-spec §5.2）
// 展示序号用「号码牌」承载（区别于来源页内位置）；sourceRank 跨条目可重复，不渲染成全局名次。
import { thous } from '../lib/format.js';

const { item, index } = Astro.props;
---
<li>
  <span class="rank-badge" aria-label={`本站展示序号 ${index}`}>{index}</span>
  <a href={item.url} target="_blank" rel="noopener noreferrer">{item.repo}</a>
  {item.language && <span class="badge">{item.language}</span>}
  <span>★ {thous(item.stars)}</span>
  <span>区间 {item.periodStars === null ? '来源未提供' : `+${thous(item.periodStars)}`}</span>
  <span class="source-rank">来源页内第 {item.sourceRank} 位</span>
  {item.description && <p class="desc">{item.description}</p>}
</li>
