---
import '../styles/station-header.css';
import { STATIONS } from '../lib/stations.js';
const path = Astro.url.pathname;
const active = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---
<a class="station-skip" href="#station-main">跳到正文</a>
<header class="station-header" data-station-header transition:persist="station-header">
  <svg class="station-glyphs" aria-hidden="true" width="0" height="0"><defs>{STATIONS.map((station, index) => <symbol id={`station-glyph-${index}`} viewBox="0 0 48 48"><path d={station.glyph} pathLength="1" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linejoin="round" stroke-linecap="round" /></symbol>)}</defs></svg>
  <div class="station-header__body">
    <a class="station-brand" href="/" aria-label="赛博粮站 · 回首页">
      <img class="station-brand__mark" src="/icon-192.png" width="192" height="192" alt="" />
      <span class="station-brand__word">
        <img src="/font-images/brand.png" width="753" height="184" alt="赛博粮站" />
        <span class="station-brand__shine" aria-hidden="true"></span>
      </span>
    </a>
    <nav class="station-nav" aria-label="主导航">
      <span class="station-nav__beam" aria-hidden="true"><i></i></span>
      <ul>{STATIONS.map((station, index) => <li><a class="station-link" href={station.href} aria-current={active(station.href) ? 'page' : undefined} data-form={station.form}>
        <svg class="station-link__glyph" aria-hidden="true" width="20" height="20" viewBox="0 0 48 48"><use href={`#station-glyph-${index}`} /></svg>
        <span class="station-link__name">{station.name}</span><span class="station-link__verb"><span aria-hidden="true">·</span>{station.verb}</span>
      </a></li>)}</ul>
    </nav>
    <a class="station-about" href="/about/" aria-current={active('/about/') ? 'page' : undefined}><span>关于</span></a>
  </div>
  <span class="station-progress" aria-hidden="true"></span>
</header>
<script>import '../scripts/station-header.js';</script>
