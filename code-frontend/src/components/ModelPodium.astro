---
// 拜将台卡（/models 前三名，frontend-spec §5.3）
// 版式线：cache-tools/design-lab/dianjiangtai-v2.html（本机试作，不发布）；
// 卡片取值全部来自 rankings 行与对应 models 记录，只读展示。
import { modelIcon, vendorInitial } from '../lib/vendors.js';
import { modelPriceLabel } from '../lib/format.js';

const { row, model } = Astro.props;
const rank = row.rank;
const name = model?.name ?? row.modelId;
const vendor = model?.vendor ?? '';
const icon = vendor ? modelIcon(vendor) : null;
---
<article class={`podium__card podium__card--${rank}`}>
  <span class="podium__medal">
    <span class="visually-hidden">本站展示序号 </span>
    {rank}
  </span>
  <span class="podium__logo">
    {
      icon ? (
        <img src={icon.url} alt="" width="28" height="28" />
      ) : (
        <i class="logo-initial">{vendorInitial(vendor)}</i>
      )
    }
  </span>
  <span class="podium__name">{name}</span>
  <p class="podium__meta">
    {vendor}
    {model?.releasedAt && ` · 入营 ${model.releasedAt}`}
  </p>
  <p class="podium__pay">俸禄 {modelPriceLabel(model)}</p>
  <span class="podium__score">{row.score} 分</span>
</article>
