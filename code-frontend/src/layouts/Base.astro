---
// 全站基础布局。
// 导航模型（frontend-spec §7）：客户端导航（ClientRouter），一期关闭过渡动画。
// 皮肤档位脚本托管在此处 <head>：硬加载时立即生效，软导航时随 head 保留。
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SkinToggle from '../components/SkinToggle.astro';
import '../styles/tokens.css';
import '../styles/site.css';
import '../styles/commerce.css';

const {
  title = null,
  description = '',
  dataUpdatedAt = null,
  sourceLabel = null,
  noindex = false,
} = Astro.props;

const SITE_NAME = '赛博粮站';
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
// 皮肤档切换控件开发期暂隐（2026-09-20 用户定）：两档全部开发完毕后再置 true 恢复显示。
const SHOW_SKIN_TOGGLE = false;
// 默认档 = 赛博档（2026-09-23 用户拍板，由朴素档翻回）；赛博增量未定稿期间生效的只有
// site.css 的三支强度变量（星海粒子 / 星海动效 / 器物动效），见 frontend-spec.md §11.1。
const DEFAULT_SKIN = 'cyber';
---
<!doctype html>
<html lang="zh-CN" data-skin={DEFAULT_SKIN} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {/* fallback="swap"：不支持 View Transitions 的浏览器也走客户端导航，
        但只做即时替换、不模拟动画——与一期「关掉动画」的决策一致。 */}
    <ClientRouter fallback="swap" />

    {/* 菜单条导航（2026-09-21 用户定：品牌与条目常驻，不随滚动显示隐藏）。
        菜单条 transition:persist 后不再随软导航重建，故「当前页」标记须在此就地重算
        （与 Nav.astro 构建期的 isActive 同规则）；副产物：品牌两张图不再重复解码，切页不闪。
        窄屏主导航横向滚动——进页时把当前板块滚到可见处（否则 /news 等靠后的入口开局在屏外），
        并在两端贴渐隐提示还有条目（属性由主导航的横滑位置派生，样式只在窄屏生效）。 */}
    <script is:inline>
      if (!window.__cgChrome) {
        window.__cgChrome = true;

        const syncCurrent = () => {
          const path = location.pathname;
          for (const link of document.querySelectorAll('.menubar nav a[href]')) {
            const href = link.getAttribute('href');
            if (href === '/' ? path === '/' : path.startsWith(href)) link.setAttribute('aria-current', 'page');
            else link.removeAttribute('aria-current');
          }
        };

        // 只挪菜单条自身，绝不用 scrollIntoView：软导航的 View Transition 期间根滚动区会临时
        // 宽出一条滚动条沟（1425 → 1440），scrollIntoView 会顺手把整页横滚 15px，
        // 页面在快照里左右抖两帧（2026-09-21 headless 实测）。手算偏移量只作用于 ul。
        const revealCurrent = () => {
          const strip = document.querySelector('.menubar nav[aria-label="主导航"] ul');
          const link = strip?.querySelector('a[aria-current="page"]');
          if (!strip || !link) return;
          const stripBox = strip.getBoundingClientRect();
          const linkBox = link.getBoundingClientRect();
          const delta = (linkBox.left + linkBox.right) / 2 - (stripBox.left + stripBox.right) / 2;
          const max = strip.scrollWidth - strip.clientWidth;
          strip.scrollLeft = Math.max(0, Math.min(max, strip.scrollLeft + delta));
        };

        const markEdges = () => {
          const nav = document.querySelector('.menubar nav[aria-label="主导航"]');
          const strip = nav?.querySelector('ul');
          if (!nav || !strip) return;
          const max = strip.scrollWidth - strip.clientWidth;
          nav.toggleAttribute('data-nav-start', strip.scrollLeft > 2);
          nav.toggleAttribute('data-nav-end', max > 2 && strip.scrollLeft < max - 2);
        };

        const setupNav = () => {
          const strip = document.querySelector('.menubar nav[aria-label="主导航"] ul');
          // 软导航不重建菜单条后这里只有一个实例；__cgEdges 仍防同页重复绑定
          if (strip && !strip.__cgEdges) {
            strip.__cgEdges = true;
            strip.addEventListener('scroll', markEdges, { passive: true });
          }
          syncCurrent();
          revealCurrent();
          markEdges();
        };

        window.addEventListener('resize', markEdges, { passive: true });
        document.addEventListener('astro:page-load', setupNav);
        setupNav();
      }
    </script>

    {/* 皮肤强度档：读写 localStorage、写回 <html>、按钮 aria 同步。
        整页一段脚本 + 事件委托，避免随组件替换重复绑定（frontend-spec §5.9、§7.2）。 */}
    <script is:inline>
      if (!window.__cgSkin) {
        window.__cgSkin = true;
        const KEY = 'cg:skin';
        // 兜底 = 赛博档（与构建期 data-skin 默认值同源，2026-09-23 用户拍板）
        const normalize = (value) => (value === 'plain' ? 'plain' : 'cyber');

        const apply = () => {
          let stored = null;
          try {
            stored = localStorage.getItem(KEY);
          } catch {
            stored = null;
          }
          const value = normalize(stored);
          document.documentElement.dataset.skin = value;
          for (const btn of document.querySelectorAll('[data-skin-set]')) {
            btn.setAttribute('aria-pressed', String(btn.dataset.skinSet === value));
          }
        };

        document.addEventListener('click', (event) => {
          const btn = event.target.closest('[data-skin-set]');
          if (!btn) return;
          try {
            localStorage.setItem(KEY, normalize(btn.dataset.skinSet));
          } catch {
            document.documentElement.dataset.skin = normalize(btn.dataset.skinSet);
          }
          apply();
        });

        // DOM 替换后、绘制前写回档位，避免闪回默认档
        document.addEventListener('astro:after-swap', apply);
        // 软导航完成后同步按钮态；模块脚本只执行一次，故监听须在此注册
        document.addEventListener('astro:page-load', apply);
        apply();
      }
    </script>

    {/* 轻量切换（frontend-spec §7.1 / §10.2）：周月切换、两榜切换、分组选择。
        只显隐「已渲染好的」面板，不重算数据，故用原生脚本而非框架岛——
        避免为三处显隐各付一份框架运行时。
        约定：容器 [data-toggle][data-toggle-current=值]，按钮 [data-toggle-value]，
        面板 [data-toggle-panel]，全部在容器内查找，同页多个切换互不干扰。 */}
    <script is:inline>
      if (!window.__cgToggle) {
        window.__cgToggle = true;

        const apply = (root) => {
          const value = root.dataset.toggleCurrent;
          for (const btn of root.querySelectorAll('[data-toggle-value]')) {
            btn.setAttribute('aria-selected', String(btn.dataset.toggleValue === value));
            btn.tabIndex = btn.dataset.toggleValue === value ? 0 : -1;
            const panel = root.querySelector('[data-toggle-panel="' + btn.dataset.toggleValue + '"]');
            if (panel) {
              const prefix = 'cg-toggle-' + [...document.querySelectorAll('[data-toggle]')].indexOf(root) + '-' + btn.dataset.toggleValue;
              btn.id = prefix + '-tab';
              panel.id = prefix + '-panel';
              btn.setAttribute('aria-controls', panel.id);
              panel.setAttribute('role', 'tabpanel');
              panel.setAttribute('aria-labelledby', btn.id);
            }
          }
          for (const panel of root.querySelectorAll('[data-toggle-panel]')) {
            panel.hidden = panel.dataset.togglePanel !== value;
          }
        };

        document.addEventListener('click', (event) => {
          const target = event.target instanceof Element ? event.target : null;
          const btn = target?.closest('[data-toggle-value]');
          const root = btn?.closest('[data-toggle]');
          if (!root) return;
          root.dataset.toggleCurrent = btn.dataset.toggleValue;
          apply(root);
        });

        document.addEventListener('astro:page-load', () => {
          for (const root of document.querySelectorAll('[data-toggle]')) apply(root);
        });
        document.addEventListener('keydown', (event) => {
          const btn = event.target instanceof Element ? event.target.closest('[data-toggle-value]') : null;
          const root = btn?.closest('[data-toggle]');
          if (!root || !['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
          const buttons = [...root.querySelectorAll('[data-toggle-value]')];
          const offset = event.key === 'ArrowLeft' ? -1 : 1;
          const index = event.key === 'Home' ? 0 : event.key === 'End' ? buttons.length - 1 : (buttons.indexOf(btn) + offset + buttons.length) % buttons.length;
          event.preventDefault();
          root.dataset.toggleCurrent = buttons[index].dataset.toggleValue;
          apply(root);
          buttons[index].focus();
        });
      }
    </script>

    {/* 全页星尘（2026-09-20 用户确认：从点将台试作提为全站装饰层）：固定 canvas 二维飘尘。
        静态纪律：prefers-reduced-motion 下不启动；软导航按 astro:page-load 重建、
        astro:before-swap 释放（frontend-spec §7.4）。 */}
    <script>
      // 点将台试作同步的全站装饰层（2026-09-20 用户确认全站铺开）。
      // 走 Astro 打包（非 is:inline）：脚本只下一次并跨页缓存，不给每张 HTML 增重。
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      const palette = ['#e8b73a', '#e8b73a', '#3fd9c0', '#f5ecd8'];
      let release = null;

      const boot = () => {
        release?.();
        release = null;
        const canvas = document.querySelector('[data-bg-motes]');
        const ctx = canvas?.getContext('2d');
        if (!ctx) return;

        const controller = new AbortController();
        const { signal } = controller;
        let width = 0, height = 0, frame = 0, previous = 0, dust = [];

        const resize = () => {
          const density = Math.min(devicePixelRatio || 1, 2);
          width = innerWidth;
          height = innerHeight;
          canvas.width = Math.round(width * density);
          canvas.height = Math.round(height * density);
          ctx.setTransform(density, 0, 0, density, 0, 0);
          const count = Math.min(160, Math.max(60, Math.round((width * height) / 15000)));
            dust = Array.from({ length: count }, () => ({
              x: Math.random() * width, y: Math.random() * height, r: 0.3 + Math.random() * 1.6,
              fall: 5 + Math.random() * 15, sway: 0.3 + Math.random() * 0.7,
              phase: Math.random() * 6.2832, glow: 0.35 + Math.random() * 0.55,
              twinkle: 0.5 + Math.random() * 1.4,
              color: palette[Math.floor(Math.random() * palette.length)],
            }));
        };

        const stop = () => {
          cancelAnimationFrame(frame);
          frame = 0;
          previous = 0;
          ctx.clearRect(0, 0, width, height);
        };

        const tick = (now) => {
          frame = 0;
          if (reduced.matches || document.hidden || !canvas.isConnected) return;
          const dt = Math.min((now - (previous || now)) / 1000, 0.05);
          previous = now;
          const seconds = now / 1000;
          ctx.clearRect(0, 0, width, height);
          for (const mote of dust) {
            mote.y += mote.fall * dt;
            mote.x += Math.sin(seconds * mote.sway + mote.phase) * 7 * dt;
            if (mote.y > height + 6) { mote.y = -6; mote.x = Math.random() * width; }
            if (mote.x < -8) mote.x = width + 8;
            else if (mote.x > width + 8) mote.x = -8;
            ctx.globalAlpha = mote.glow * (0.55 + 0.45 * Math.sin(seconds * mote.twinkle + mote.phase));
            ctx.fillStyle = mote.color;
            ctx.beginPath();
            ctx.arc(mote.x, mote.y, mote.r, 0, 6.2832);
            ctx.fill();
          }
          ctx.globalAlpha = 1;
          frame = requestAnimationFrame(tick);
        };

        const start = () => {
          if (!frame && !reduced.matches && !document.hidden && canvas.isConnected) {
            previous = 0;
            frame = requestAnimationFrame(tick);
          }
        };

        const onVisibility = () => (document.hidden ? stop() : start());
        const onReducedChange = () => (reduced.matches ? stop() : start());
        release = () => { controller.abort(); stop(); };

        resize();
        window.addEventListener('resize', resize, { signal });
        document.addEventListener('visibilitychange', onVisibility, { signal });
        reduced.addEventListener('change', onReducedChange, { signal });
        start();
      };

      document.addEventListener('astro:before-swap', () => { release?.(); release = null; });
      document.addEventListener('astro:page-load', boot);
    </script>

    {/* 观星台页头 · 星海装饰层（frontend-spec §4.4 / §11.1，2026-09-20 拍板「甲」形态）。
        只有 /github 的页头带出 canvas 时才取引擎；取件排在首屏之后（requestIdleCallback），
        引擎是独立 chunk，不进首屏 JS（§10.2 无岛页预算）。软导航按 astro:page-load 重建、
        astro:before-swap 释放——与全站星尘同一套生命周期。 */}
    <script>
      let sea = null;
      let seaQueued = null;
      const seaRelease = () => {
        if (seaQueued) cancelIdleCallback?.(seaQueued);
        seaQueued = null;
        sea?.release();
        sea = null;
      };
      const seaBoot = () => {
        if (!document.querySelector('[data-star-sea-canvas]')) return seaRelease();
        if (sea || seaQueued) return;
        const idle = window.requestIdleCallback || ((fn) => setTimeout(fn, 240));
        seaQueued = idle(() => {
          seaQueued = null;
          if (!document.querySelector('[data-star-sea-canvas]')) return;
          import('../scripts/star-sea.js')
            .then(({ mount }) => {
              seaRelease();
              sea = mount();
            })
            // 取件或初始化失败：收掉图腾区加载态，别让占位一直转（该页文字与榜单照常可用）
            .catch((error) => {
              console.warn('星海未能启用：', error);
              document.querySelector('[data-star-sea]')?.setAttribute('data-totem', 'off');
            });
        });
      };
      document.addEventListener('astro:before-swap', seaRelease);
      document.addEventListener('astro:page-load', seaBoot);
      seaBoot();
    </script>

    {/* 点将台页头 · 电磁虎符图腾（frontend-spec §4.5，2026-09-22 用户拍板）。
        与星海同一套加载纪律：只有 /models 页头出画布时才取引擎，取件排在首屏之后，
        引擎是独立 chunk，不进首屏 JS（§10.2 无岛页预算）；软导航按 astro:page-load 重建、
        astro:before-swap 释放。 */}
    <script>
      let tally = null;
      let tallyQueued = null;
      const tallyRelease = () => {
        if (tallyQueued) cancelIdleCallback?.(tallyQueued);
        tallyQueued = null;
        tally?.release();
        tally = null;
      };
      const tallyBoot = () => {
        if (!document.querySelector('[data-tiger-canvas]')) return tallyRelease();
        if (tally || tallyQueued) return;
        const idle = window.requestIdleCallback || ((fn) => setTimeout(fn, 240));
        tallyQueued = idle(() => {
          tallyQueued = null;
          if (!document.querySelector('[data-tiger-canvas]')) return;
          import('../scripts/tiger-tally.js')
            .then(({ mount }) => {
              tallyRelease();
              tally = mount();
            })
            // 取件或初始化失败：收掉图腾区加载态（虎符已有 unavailable 分支，这里是兜底）
            .catch((error) => {
              console.warn('虎符图腾未能启用：', error);
              document.querySelector('[data-tiger-tally]')?.setAttribute('data-totem', 'off');
            });
        });
      };
      document.addEventListener('astro:before-swap', tallyRelease);
      document.addEventListener('astro:page-load', tallyBoot);
      tallyBoot();
    </script>

    {/* 粮市页头 · 杆秤图腾（frontend-spec §4.6，2026-09-22 用户拍板：乙案「杆秤 · 称量」+ 光核）。
        与星海 / 虎符同一套加载纪律：只有 /plans 页头出画布时才取引擎，取件排在首屏之后，
        引擎是独立 chunk，不进首屏 JS（§10.2 无岛页预算）；软导航按 astro:page-load 重建、
        astro:before-swap 释放。 */}
    <script>
      let scale = null;
      let scaleQueued = null;
      const scaleRelease = () => {
        if (scaleQueued) cancelIdleCallback?.(scaleQueued);
        scaleQueued = null;
        scale?.release();
        scale = null;
      };
      const scaleBoot = () => {
        if (!document.querySelector('[data-steelyard-canvas]')) return scaleRelease();
        if (scale || scaleQueued) return;
        const idle = window.requestIdleCallback || ((fn) => setTimeout(fn, 240));
        scaleQueued = idle(() => {
          scaleQueued = null;
          if (!document.querySelector('[data-steelyard-canvas]')) return;
          import('../scripts/steelyard.js')
            .then(({ mount }) => {
              scaleRelease();
              scale = mount();
            })
            // 取件或初始化失败：收掉图腾区加载态，别让占位一直转（套餐列表照常可用）
            .catch((error) => {
              console.warn('杆秤图腾未能启用：', error);
              document.querySelector('[data-steelyard]')?.setAttribute('data-totem', 'off');
            });
        });
      };
      document.addEventListener('astro:before-swap', scaleRelease);
      document.addEventListener('astro:page-load', scaleBoot);
      scaleBoot();
    </script>

    {/* 详情弹框预览（frontend-spec §5.10 票证 / §5.11 套餐）。
        渐进增强：`<a href="/tickets/xxx/">`、`<a href="/plans/xxx/">` 保持真链接——
        爬虫可抓、新窗口可开、无 JS 正常跳转、直接访问该 URL 仍是完整独立页。
        只有左键普通点击才拦下来开弹框。内容按需 fetch 该 URL 并抽取 <main>，
        **不把详情内联进列表页**（§10.2「列表类页面的数据只允许出现一份」）。

        历史行为（2026-09-23 UI 审查：粮票详情 02 / 套餐详情 02）：
        预览**压入一条自己的历史条目**（state 带 cgPreview / base），于是——
        后退 = 关闭预览并回到打开前地址，前进 = 重开预览，Esc / 关闭键与浏览器后退等价。
        两处关键取舍（都有实测依据）：
        1. 用捕获阶段 + stopPropagation 压住 ClientRouter 的 click 监听（它在冒泡阶段）。
        2. popstate 必须**先于** ClientRouter 的监听被处理：本段是 <head> 里的行内经典脚本，
           先于 ClientRouter 的模块脚本注册；接管时 stopImmediatePropagation，避免它把
           同一跳转再做一次软导航（那会让弹框与地址互相打架）。
           其余 popstate 一律放行给 ClientRouter（例如预览条目已过期、底层页面已换）。

        动效（动效专项 P1）：入场保持现有 CSS（约 160–220ms）；退场补一段等长反馈
        （约 170ms），骨架 → 正文不改到达时间、只把新内容淡入（约 140ms）。
        只动 opacity / transform，不改弹框尺寸；重复操作取消旧动画；
        prefers-reduced-motion 下全部直切。 */}
    <script is:inline>
      if (!window.__cgPreview) {
        window.__cgPreview = true;
        const LINK = 'a[href^="/tickets/"], a[href^="/plans/"]';
        const EXIT_MS = 170;
        const SWAP_IN_MS = 140;
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

        let overlay = null;
        let panel = null;
        let backdrop = null;
        let scroller = null;
        let content = null;
        let lastFocus = null;
        let fromUrl = null;
        let request = null;
        let dock = null;
        let background = [];
        let exitAnimations = [];
        let exitRun = 0;
        let closing = false;
        let suppressPopstate = false;
        let swapToken = 0;
        // 当前**渲染内容**对应的地址（弹框只改地址栏、不换内容，故不能读 location）
        let docUrl = location.pathname + location.search + location.hash;

        // 软导航会整体替换 <body>，缓存节点随之离线——必须以「是否仍在文档中」判断重建，
        // 否则第二次打开弹框时 build() 直接返回，弹框永远不出现（2026-09-18 实测踩坑）。
        // 结构（2026-09-20）：外框不滚动，顶栏吸在框内、滚动区独立——关闭键与边框角标不随内容滚走。
        const build = () => {
          if (overlay && overlay.isConnected) return;
          overlay = document.createElement('div');
          overlay.className = 'preview';
          overlay.setAttribute('role', 'dialog');
          overlay.setAttribute('aria-modal', 'true');
          overlay.setAttribute('aria-label', '详情预览');
          overlay.hidden = true;
          overlay.innerHTML =
            '<div class="preview__backdrop" data-preview-close></div>' +
            '<div class="preview__panel" tabindex="-1">' +
            '<div class="preview__bar">' +
            '<span class="preview__label">详情预览</span>' +
            '<a class="preview__page" data-preview-page data-astro-reload>独立详情页 ↗</a>' +
            '<button type="button" class="preview__close" data-preview-close aria-label="关闭预览">' +
            '<span class="preview__close-x" aria-hidden="true">✕</span>关闭' +
            '</button>' +
            '</div>' +
            '<div class="preview__scroll">' +
            '<div class="preview__content" data-preview-content></div>' +
            '</div>' +
            '<div class="preview__dock" hidden></div>' +
            '</div>';
          document.body.appendChild(overlay);
          panel = overlay.querySelector('.preview__panel');
          backdrop = overlay.querySelector('.preview__backdrop');
          scroller = overlay.querySelector('.preview__scroll');
          content = overlay.querySelector('[data-preview-content]');
          dock = overlay.querySelector('.preview__dock');
        };

        const focusables = () =>
          [...panel.querySelectorAll('a[href], button, [tabindex]:not([tabindex="-1"])')].filter(
            (el) => !el.hasAttribute('disabled') && el.offsetParent !== null
          );

        // 锁滚动时补回滚动条宽度，否则弹框一开、背后整页向右跳一下（2026-09-20）。
        const lockScroll = () => {
          const gap = window.innerWidth - document.documentElement.clientWidth;
          document.documentElement.style.overflow = 'hidden';
          document.body.style.overflow = 'hidden';
          if (gap > 0) document.body.style.paddingRight = gap + 'px';
        };

        const unlockScroll = () => {
          document.documentElement.style.overflow = '';
          document.body.style.overflow = '';
          document.body.style.paddingRight = '';
        };

        // 入场是 CSS 动画（display:none → block 会自然重放）；退场前把它清掉，
        // 免得 fill: both 的结束态和退场动画抢同一条属性。
        const clearEntryAnimations = () => {
          for (const el of [backdrop, panel]) {
            if (!el?.getAnimations) continue;
            for (const a of el.getAnimations()) if (a.animationName) a.cancel();
          }
        };

        const cancelExit = () => {
          exitRun += 1;
          const ran = exitAnimations.length > 0;
          for (const a of exitAnimations) a.cancel();
          exitAnimations = [];
          return ran;
        };

        // 退场：约 170ms，只动 opacity / transform。动画结束才真正隐藏；
        // 重复关闭（Esc 连按 / 遮罩连点）由 closing 位挡住。
        const animateExit = (onDone) => {
          exitRun += 1;
          const run = exitRun;
          for (const a of exitAnimations) a.cancel();
          exitAnimations = [];
          if (reduced.matches || typeof panel?.animate !== 'function') {
            onDone();
            return;
          }
          clearEntryAnimations();
          const fade = backdrop?.animate([{ opacity: 1 }, { opacity: 0 }], {
            duration: EXIT_MS,
            easing: 'ease',
            fill: 'forwards',
          });
          const rise = panel.animate(
            [{ opacity: 1, transform: 'none' }, { opacity: 0, transform: 'translateY(8px)' }],
            { duration: EXIT_MS, easing: 'cubic-bezier(.4, 0, .7, .2)', fill: 'forwards' }
          );
          exitAnimations = [fade, rise].filter(Boolean);
          Promise.allSettled(exitAnimations.map((a) => a.finished)).then(() => {
            if (run !== exitRun) return;
            for (const a of exitAnimations) a.cancel();
            exitAnimations = [];
            onDone();
          });
        };

        // 快开快关：退场途中重开时，先取消退场，再补一段短促的「回位」，
        // 避免面板从半透明瞬跳回全亮（只此一处额外动画，reduced 下不挂）。
        const settleIn = () => {
          const interrupted = cancelExit();
          if (!interrupted || reduced.matches || typeof panel?.animate !== 'function') return;
          panel.animate(
            [{ opacity: .35, transform: 'translateY(5px)' }, { opacity: 1, transform: 'none' }],
            { duration: 160, easing: 'cubic-bezier(.2, .7, .3, 1)' }
          );
          backdrop?.animate([{ opacity: .4 }, { opacity: 1 }], { duration: 160, easing: 'ease' });
        };

        // 骨架 → 正文（失败态同理）：不延后内容到达，只把新内容淡入约 140ms。
        const swapContent = (html) => {
          swapToken += 1;
          content.innerHTML = html;
          if (reduced.matches || typeof content.animate !== 'function') return;
          content.animate(
            [{ opacity: .3, transform: 'translateY(4px)' }, { opacity: 1, transform: 'none' }],
            { duration: SWAP_IN_MS, easing: 'cubic-bezier(.2, .7, .3, 1)' }
          );
        };

        const historyIsPreview = () => Boolean(window.history.state && window.history.state.cgPreview);

        const finishClose = () => {
          closing = false;
          if (!overlay) return;
          overlay.hidden = true;
          overlay.removeAttribute('aria-busy');
          if (lastFocus instanceof HTMLElement && lastFocus.isConnected) lastFocus.focus({ preventScroll: true });
          lastFocus = null;
        };

        // viaHistory = 由浏览器后退/前进触发的关闭：地址已经由浏览器改好，这里不再动历史。
        const close = ({ viaHistory = false } = {}) => {
          if (!overlay || overlay.hidden || closing) return;
          closing = true;
          swapToken += 1;
          request?.abort();
          request = null;
          // 退场期间就放开背景：动画不延后「点回列表」的响应
          background.forEach((el) => { el.inert = false; });
          background = [];
          unlockScroll();
          if (!viaHistory) {
            if (historyIsPreview()) {
              // 打开时压入的就是本弹框的条目：后退一条 = 回到打开前地址（popstate 由上面接管）
              suppressPopstate = true;
              window.history.back();
            } else if (fromUrl) {
              window.history.replaceState(window.history.state, '', fromUrl);
            }
          }
          fromUrl = null;
          animateExit(finishClose);
        };

        const open = async (url, options = {}) => {
          build();
          const fresh = overlay.hidden;   // 全新打开（false = 换对象或退场途中重开）
          closing = false;
          settleIn();
          request?.abort();
          const controller = new AbortController();
          request = controller;
          if (fresh) {
            // 前进回到预览条目时，打开前地址要按条目里记的 base 还原，不能读当前 location；
            // 这一条历史本来就属于本弹框，viaHistory 下不再新增条目（否则回退链会越走越长）
            fromUrl = options.base ?? window.location.pathname + window.location.search + window.location.hash;
            lastFocus = document.activeElement;
            if (!options.viaHistory) {
              window.history.pushState({ ...window.history.state, cgPreview: url, base: fromUrl }, '', url);
            }
          } else {
            // 弹框内换对象（同一入口连续点开）：替换当前预览条目，后退仍一步回到列表
            window.history.replaceState({ ...window.history.state, cgPreview: url, base: fromUrl }, '', url);
          }
          overlay.hidden = false;
          // 背景态（inert + 滚动锁）每次重算：退场途中重开时，close() 已经把它们撤掉过一次
          background.forEach((el) => { el.inert = false; });
          background = [...document.body.children].filter((el) => el instanceof HTMLElement && el !== overlay && !el.inert && !['SCRIPT', 'STYLE'].includes(el.tagName));
          background.forEach((el) => { el.inert = true; });
          lockScroll();
          const kind = url.startsWith('/plans/') ? 'plans' : 'tickets';
          overlay.dataset.kind = kind;
          overlay.querySelector('.preview__label').textContent = kind === 'plans' ? '粮市 / 套餐档案' : '粮票 / 票面详情';
          overlay.querySelector('[data-preview-page]').setAttribute('href', url);
          overlay.setAttribute('aria-label', kind === 'plans' ? '套餐详情' : '粮票详情');
          overlay.setAttribute('aria-busy', 'true');
          content.innerHTML = '<div class="preview__skeleton" aria-hidden="true"><i></i><i></i><i></i></div><p class="preview__loading" role="status">正在取件…</p>';
          dock.replaceChildren();
          dock.hidden = true;
          if (scroller) scroller.scrollTop = 0;
          panel.focus();
          const timeout = window.setTimeout(() => controller.abort(), 15000);
          try {
            const res = await fetch(url, { headers: { Accept: 'text/html' }, signal: controller.signal });
            if (!res.ok) throw new Error(String(res.status));
            const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
            if (request !== controller || overlay.hidden) return;
            const main = doc.querySelector('main');
            if (!main) throw new Error('no main');
            // 弹框是「先看一眼」的入口：首页/列表里去掉核实信息与相关票两块，
            // 保持轻量；它们仍在独立详情页 /tickets/[id]/ 完整提供（frontend-spec §4.3）。
            main
              .querySelectorAll('script, [aria-labelledby="verify"], [aria-labelledby="related"]')
              .forEach((el) => el.remove());
            // 详情页顶部的「← 返回粮票 / 返回套餐榜」在弹框里是噪音——关闭即回到打开前地址，
            // 同样只在弹框内去掉（独立详情页保留）。
            main.querySelectorAll('p').forEach((p) => {
              const a = p.querySelector('a');
              if (a && a.textContent.trim() === p.textContent.trim() && /^\/(tickets|plans)\/$/.test(a.getAttribute('href') || '')) {
                p.remove();
              }
            });
            const actions = main.querySelector('.plan-detail__foot, .ticket__actions');
            if (actions) actions.remove();
            swapContent(main.innerHTML);
            const heading = content.querySelector('h1');
            if (heading) overlay.setAttribute('aria-label', heading.textContent.trim());
            if (actions) {
              dock.appendChild(actions);
              dock.hidden = false;
            }
          } catch (error) {
            if (request !== controller || overlay.hidden) return;
            swapContent('<p class="preview__error" role="alert">' + (controller.signal.aborted ? '取件超时' : '取件失败') + '，<a data-preview-page data-astro-reload href="' + url + '">直接打开详情页</a>。</p>');
          } finally {
            window.clearTimeout(timeout);
            if (request === controller) overlay.removeAttribute('aria-busy');
          }
        };

        document.addEventListener(
          'click',
          (event) => {
            const target = event.target instanceof Element ? event.target : null;
            const link = target?.closest(LINK);
            if (!link) return;
            if (link.hasAttribute('data-preview-page')) return;
            if (event.defaultPrevented || event.button !== 0) return;
            if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
            if (link.target && link.target !== '_self') return;
            if (link.hasAttribute('download')) return;
            // 「← 返回套餐榜」这类回列表链接不拦截，按正常导航走
            if (/^\/(tickets|plans)\/$/.test(link.getAttribute('href'))) return;
            // 捕获阶段：阻止事件继续冒泡到 ClientRouter 的 click 监听
            event.preventDefault();
            event.stopPropagation();
            open(link.getAttribute('href'));
          },
          true
        );

        document.addEventListener('click', (event) => {
          const target = event.target instanceof Element ? event.target : null;
          if (target?.closest('[data-preview-close]')) close();
        });

        // 必须在 ClientRouter 的 popstate 之前接管（本脚本是行内经典脚本，注册在先）：
        // ① 自己发起的后退（关闭弹框）→ 吃掉这一次，别让它再走软导航；
        // ② 弹框开着时的前进/后退 → 先关弹框，地址交给浏览器；
        // ③ 弹框已关、又前进回到预览条目且底层页面还是打开它的那一页 → 重开；
        // 其余一律放行（例如底层页面已换，让 ClientRouter 正常软导航）。
        window.addEventListener('popstate', (event) => {
          if (suppressPopstate) {
            suppressPopstate = false;
            event.stopImmediatePropagation();
            return;
          }
          if (overlay && !overlay.hidden) {
            event.stopImmediatePropagation();
            close({ viaHistory: true });
            return;
          }
          const state = window.history.state;
          if (state && state.cgPreview && state.base === docUrl) {
            event.stopImmediatePropagation();
            open(state.cgPreview, { base: state.base, viaHistory: true });
          }
        });

        document.addEventListener('keydown', (event) => {
          if (!overlay || overlay.hidden || closing) return;
          if (event.key === 'Escape') {
            event.preventDefault();
            close();
            return;
          }
          if (event.key !== 'Tab') return;
          const list = focusables();
          if (list.length === 0) return;
          const first = list[0];
          const last = list[list.length - 1];
          if (event.shiftKey && (document.activeElement === first || document.activeElement === panel)) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        });

        // 记录「当前渲染内容」的地址：软导航换页后前进回到预览条目要按它判断能不能重开
        document.addEventListener('astro:page-load', () => {
          docUrl = location.pathname + location.search + location.hash;
        });

        // 弹框内点走真实导航（回列表链接、外链之外的站内链）时，软导航只换 <body>：
        // 缓存的弹框节点离线、<html> 上的内联 overflow 却会留下——不清理就会带着滚动锁进新页
        //（2026-09-20 实测踩坑）。这里只复位状态，不动 history。
        document.addEventListener('astro:after-swap', () => {
          if (!overlay) return;
          closing = false;
          cancelExit();
          swapToken += 1;
          request?.abort();
          request = null;
          background.forEach((el) => { el.inert = false; });
          background = [];
          overlay.hidden = true;
          overlay.removeAttribute('aria-busy');
          unlockScroll();
          fromUrl = null;
          lastFocus = null;
        });
      }
    </script>
  </head>

  <body>
    {/* 全站星尘画布：固定层压在内容之下（site.css .bg-motes，z-index -1） */}
    <canvas class="bg-motes" data-bg-motes aria-hidden="true"></canvas>
    {/* 菜单条吸顶；站名横额与票碗徽记同行常驻（2026-09-21 用户定）。
        transition:persist —— 软导航不重建菜单条，否则品牌两张图随 <body> 一起重建，
        重新解码期间会闪一下（2026-09-21 用户反馈「切菜单时 logo 与徽记闪一下」）。
        页脚**不**persist：它带本页的数据核验时间（§5.9、数据契约 §3.3）。 */}
    <header class="menubar" transition:persist>
      <div class="menubar__inner">
        <a class="topbar__logo" href="/" aria-label="赛博粮站 · 回首页">
          <img
            class="topbar__logo-word"
            src="/font-images/brand.png"
            width="753"
            height="184"
            alt="赛博粮站"
            decoding="sync"
          />
          <img
            class="topbar__logo-mark"
            src="/icon-192.png"
            width="192"
            height="192"
            alt=""
            decoding="sync"
          />
        </a>
        <Nav />
        {SHOW_SKIN_TOGGLE && <SkinToggle />}
      </div>
    </header>

    <main>
      <slot />
    </main>

    <Footer dataUpdatedAt={dataUpdatedAt} sourceLabel={sourceLabel} />
  </body>
</html>
